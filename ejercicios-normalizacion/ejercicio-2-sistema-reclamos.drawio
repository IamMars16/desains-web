l=1;whiteSpace=wrap;" vertex="1" parent="ej2m-jefe_area-r0"><mxGeometry width="62" height="26" as="geometry"><mxRectangle width="62" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej2m-jefe_area-r0-a" value="jefe_area" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=1;fontSize=12;fontColor=#1A1A1A;align=left;spacingLeft=6;overflow=hidden;html=1;whiteSpace=wrap;" vertex="1" parent="ej2m-jefe_area-r0"><mxGeometry x="62" width="208" height="26" as="geometry"><mxRectangle width="208" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej2m-jefe_area-r1" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;strokeColor=#1F3A5F;html=1;" vertex="1" parent="ej2m-jefe_area"><mxGeometry y="56" width="270" height="26" as="geometry"/></mxCell><mxCell id="ej2m-jefe_area-r1-k" value="" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=1;fontSize=11;fontColor=#2E75B6;align=left;spacingLeft=8;overflow=hidden;html=1;whiteSpace=wrap;" vertex="1" parent="ej2m-jefe_area-r1"><mxGeometry width="62" height="26" as="geometry"><mxRectangle width="62" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej2m-jefe_area-r1-a" value="telefono_jefe" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=0;fontSize=12;fontColor=#1A1A1A;align=left;spacingLeft=6;overflow=hidden;html=1;whiteSpace=wrap;" vertex="1" parent="ej2m-jefe_area-r1"><mxGeometry x="62" width="208" height="26" as="geometry"><mxRectangle width="208" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej2m-e0" value="PRESENTA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.2312;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2687;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej2m-cliente" target="ej2m-reclamo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej2m-e1" value="CLASIFICA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.3981;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.2687;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej2m-categoria" target="ej2m-reclamo"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej2m-e2" value="INCLUYE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.9187;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5244;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej2m-reclamo" target="ej2m-archivo_adjunto"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="385.0" y="267.0"/><mxPoint x="385.0" y="449.0"/></Array></mxGeometry></mxCell><mxCell id="ej2m-e3" value="TIENE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej2m-reclamo" target="ej2m-seguimiento"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej2m-e4" value="ATIENDE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.3981;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.2687;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej2m-agente" target="ej2m-seguimiento"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej2m-e5" value="PERTENECE A" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.5244;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3981;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej2m-area" target="ej2m-agente"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej2m-e6" value="RESPONSABLE DE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.8796;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej2m-area" target="ej2m-categoria"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1435.0" y="215.0"/></Array></mxGeometry></mxCell><mxCell id="ej2m-e7" value="TIENE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=1.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej2m-jefe_area" target="ej2m-area"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej2m-legend" value="&lt;b style=&quot;color:#C55A11&quot;&gt;PK&lt;/b&gt; clave primaria &amp;nbsp;·&amp;nbsp; &lt;b style=&quot;color:#2E75B6&quot;&gt;FK&lt;/b&gt; clave foránea &amp;nbsp;·&amp;nbsp; &lt;b&gt;||&lt;/b&gt; = uno &amp;nbsp;·&amp;nbsp; pata de gallo = muchos" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="788" width="1530" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ej2-analisis" name="A1–A4 · Análisis"><mxGraphModel dx="1260" dy="906" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="906" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ej2a-title" value="Ejercicio 2 · Sistema de reclamos — Análisis (A1–A4)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej2a-A1-h" value="A1 · Atributos que violan la 1FN" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej2a-A1-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;CLIENTE.nombre_completo&lt;/b&gt; → no atómico. Guarda nombres y apellidos juntos (&amp;quot;Ana Quispe Rojas&amp;quot;), por lo que no se puede buscar ni ordenar por apellido. Solución: separar en &lt;b&gt;nombres&lt;/b&gt; y &lt;b&gt;apellidos&lt;/b&gt;.&lt;br&gt;•&amp;nbsp; &lt;b&gt;RECLAMO.archivos_adjuntos&lt;/b&gt; → multivaluado. Guarda varios nombres de archivo separados por punto y coma (&amp;quot;foto1.jpg;boleta.pdf&amp;quot;). Solución: tabla &lt;b&gt;ARCHIVO_ADJUNTO(nro_reclamo, nombre_archivo)&lt;/b&gt;, una fila por archivo.&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1180" height="98" as="geometry"/></mxCell><mxCell id="ej2a-A2-h" value="A2 · Dependencias funcionales y dependencias parciales (2FN)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="232" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej2a-A2-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;CLIENTE:&lt;/b&gt; cod_cliente → nombre_completo, dni, correo, telefono&lt;br&gt;•&amp;nbsp; &lt;b&gt;RECLAMO:&lt;/b&gt; nro_reclamo → cod_cliente, nombre_cliente, fecha_registro, cod_categoria, nombre_categoria, area_responsable, archivos_adjuntos, estado  ·  cod_cliente → nombre_cliente  ·  cod_categoria → nombre_categoria, area_responsable&lt;br&gt;•&amp;nbsp; &lt;b&gt;AGENTE:&lt;/b&gt; cod_agente → nombre, area, jefe_area, telefono_jefe  ·  area → jefe_area  ·  jefe_area → telefono_jefe&lt;br&gt;•&amp;nbsp; &lt;b&gt;SEGUIMIENTO:&lt;/b&gt; (nro_reclamo, nro_paso) → cod_agente, nombre_agente, fecha_paso, accion_realizada, fecha_registro_reclamo  ·  nro_reclamo → fecha_registro_reclamo  ·  cod_agente → nombre_agente&lt;br&gt;•&amp;nbsp; &lt;b&gt;Dependencia parcial:&lt;/b&gt; en SEGUIMIENTO, fecha_registro_reclamo depende solo de nro_reclamo (una parte de la PK) y repite RECLAMO.fecha_registro. Se elimina de SEGUIMIENTO. CLIENTE, RECLAMO y AGENTE tienen PK simple, por eso no tienen dependencias parciales.&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="262" width="1180" height="170" as="geometry"/></mxCell><mxCell id="ej2a-A3-h" value="A3 · Dependencias transitivas (3FN) y atributos derivados" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="456" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej2a-A3-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;RECLAMO:&lt;/b&gt; nro_reclamo → cod_cliente → nombre_cliente. nombre_cliente ya está en CLIENTE: se elimina de RECLAMO.&lt;br&gt;•&amp;nbsp; &lt;b&gt;RECLAMO:&lt;/b&gt; nro_reclamo → cod_categoria → nombre_categoria, area_responsable. Se crea &lt;b&gt;CATEGORIA(cod_categoria, nombre_categoria, area_responsable)&lt;/b&gt; (cada categoría tiene una única área responsable).&lt;br&gt;•&amp;nbsp; &lt;b&gt;AGENTE:&lt;/b&gt; cod_agente → area → jefe_area → telefono_jefe. Se crean &lt;b&gt;AREA(area, jefe_area)&lt;/b&gt; (cada área tiene un único jefe) y &lt;b&gt;JEFE_AREA(jefe_area, telefono_jefe)&lt;/b&gt; (el teléfono es del jefe). AGENTE conserva area como FK y CATEGORIA.area_responsable también referencia a AREA.&lt;br&gt;•&amp;nbsp; &lt;b&gt;SEGUIMIENTO:&lt;/b&gt; (nro_reclamo, nro_paso) → cod_agente → nombre_agente. nombre_agente ya está en AGENTE: se elimina de SEGUIMIENTO.&lt;br&gt;•&amp;nbsp; &lt;b&gt;Atributos derivados:&lt;/b&gt; ninguno se calcula. nombre_cliente, nombre_agente y fecha_registro_reclamo son copias redundantes de datos que ya existen en otra tabla.&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="486" width="1180" height="152" as="geometry"/></mxCell><mxCell id="ej2a-A4-h" value="A4 · Dependencias funcionales del modelo corregido" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="662" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej2a-A4-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;CLIENTE:&lt;/b&gt; cod_cliente → nombres, apellidos, dni, correo, telefono&lt;br&gt;•&amp;nbsp; &lt;b&gt;CATEGORIA:&lt;/b&gt; cod_categoria → nombre_categoria, area_responsable&lt;br&gt;•&amp;nbsp; &lt;b&gt;AREA:&lt;/b&gt; area → jefe_area&lt;br&gt;•&amp;nbsp; &lt;b&gt;JEFE_AREA:&lt;/b&gt; jefe_area → telefono_jefe&lt;br&gt;•&amp;nbsp; &lt;b&gt;AGENTE:&lt;/b&gt; cod_agente → nombre, area&lt;br&gt;•&amp;nbsp; &lt;b&gt;RECLAMO:&lt;/b&gt; nro_reclamo → cod_cliente, cod_categoria, fecha_registro, estado&lt;br&gt;•&amp;nbsp; &lt;b&gt;ARCHIVO_ADJUNTO:&lt;/b&gt; (nro_reclamo, nombre_archivo) → clave completa (no tiene atributos no clave)&lt;br&gt;•&amp;nbsp; &lt;b&gt;SEGUIMIENTO:&lt;/b&gt; (nro_reclamo, nro_paso) → cod_agente, fecha_paso, accion_realizada&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="692" width="1180" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>