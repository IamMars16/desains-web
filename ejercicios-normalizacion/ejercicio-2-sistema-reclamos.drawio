idth="1480" pageHeight="1300" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ej2a-title" value="Ejercicio 2 - Sistema de reclamos: análisis" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="900" height="30" as="geometry"/></mxCell><mxCell id="ej2a-p1" value="" style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#FAFAFA;strokeColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1400" height="152" as="geometry"/></mxCell><mxCell id="ej2a-p1-cap" value="A1. Atributos que violan la 1FN" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="58" y="84" width="1364" height="24" as="geometry"/></mxCell><mxCell id="ej2a-a1-0" value="nombre_completo  (CLIENTE)" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="116" width="668" height="88" as="geometry"/></mxCell><mxCell id="ej2a-a1-0-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;&lt;b&gt;No atómico:&lt;/b&gt; nombres y apellidos juntos (&amp;quot;Ana Quispe Rojas&amp;quot;).&lt;br&gt;→ separar en &lt;b&gt;nombres&lt;/b&gt; y &lt;b&gt;apellidos&lt;/b&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej2a-a1-0"><mxGeometry x="0" y="32" width="668" height="56" as="geometry"/></mxCell><mxCell id="ej2a-a1-1" value="archivos_adjuntos  (RECLAMO)" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="752" y="116" width="668" height="88" as="geometry"/></mxCell><mxCell id="ej2a-a1-1-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;&lt;b&gt;Multivaluado:&lt;/b&gt; varios archivos separados por ; (&amp;quot;foto1.jpg;boleta.pdf&amp;quot;).&lt;br&gt;→ tabla &lt;b&gt;ARCHIVO_ADJUNTO&lt;/b&gt;(nro_reclamo, nombre_archivo)&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej2a-a1-1"><mxGeometry x="0" y="32" width="668" height="56" as="geometry"/></mxCell><mxCell id="ej2a-p2" value="" style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#FAFAFA;strokeColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="1400" height="340" as="geometry"/></mxCell><mxCell id="ej2a-p2-cap" value="A2. Dependencias funcionales y dependencias parciales (2FN)" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="58" y="260" width="1364" height="24" as="geometry"/></mxCell><mxCell id="ej2a-a2-0" value="CLIENTE" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="292" width="668" height="106" as="geometry"/></mxCell><mxCell id="ej2a-a2-0-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;cod_cliente → nombre_completo, dni, correo, telefono&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej2a-a2-0"><mxGeometry x="0" y="32" width="668" height="74" as="geometry"/></mxCell><mxCell id="ej2a-a2-1" value="RECLAMO" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="752" y="292" width="668" height="106" as="geometry"/></mxCell><mxCell id="ej2a-a2-1-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;nro_reclamo → cod_cliente, fecha_registro, cod_categoria, archivos_adjuntos, estado&lt;br&gt;cod_cliente → nombre_cliente &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(transitiva)&lt;/font&gt;&lt;/i&gt;&lt;br&gt;cod_categoria → nombre_categoria, area_responsable &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(transitiva)&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej2a-a2-1"><mxGeometry x="0" y="32" width="668" height="74" as="geometry"/></mxCell><mxCell id="ej2a-a2-2" value="AGENTE" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="422" width="668" height="106" as="geometry"/></mxCell><mxCell id="ej2a-a2-2-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;cod_agente → nombre, area&lt;br&gt;area → jefe_area &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(transitiva)&lt;/font&gt;&lt;/i&gt;&lt;br&gt;jefe_area → telefono_jefe &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(transitiva)&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej2a-a2-2"><mxGeometry x="0" y="32" width="668" height="74" as="geometry"/></mxCell><mxCell id="ej2a-a2-3" value="SEGUIMIENTO" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="752" y="422" width="668" height="106" as="geometry"/></mxCell><mxCell id="ej2a-a2-3-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;(nro_reclamo, nro_paso) → cod_agente, fecha_paso, accion_realizada&lt;br&gt;nro_reclamo → fecha_registro_reclamo &lt;font color=&quot;#C0392B&quot;&gt;&lt;b&gt;(parcial)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;cod_agente → nombre_agente &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(transitiva)&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej2a-a2-3"><mxGeometry x="0" y="32" width="668" height="74" as="geometry"/></mxCell><mxCell id="ej2a-a2c" value="&lt;b&gt;Parcial:&lt;/b&gt; en SEGUIMIENTO, fecha_registro_reclamo depende solo de nro_reclamo y ya está en RECLAMO (fecha_registro), así que se quita. Las otras tablas tienen PK simple." style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=12;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="60" y="542" width="1360" height="26" as="geometry"/></mxCell><mxCell id="ej2a-p3" value="" style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#FAFAFA;strokeColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="40" y="614" width="1400" height="358" as="geometry"/></mxCell><mxCell id="ej2a-p3-cap" value="A3. Dependencias transitivas (3FN) y atributos derivados" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="58" 