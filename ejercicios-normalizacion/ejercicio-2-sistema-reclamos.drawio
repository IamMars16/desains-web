xt;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="194.0" y="632.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej2a-A2-t3" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#C9D3DF;" vertex="1" parent="1"><mxGeometry x="760.0" y="534.0" width="700.0" height="132.0" as="geometry"/></mxCell><mxCell id="ej2a-A2-t3-h" value="&lt;b&gt;SEGUIMIENTO&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#5B6773;font-size:11px&quot;&gt;(tabla original) · PK compuesta: (nro_reclamo, nro_paso)&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#EAF0F7;strokeColor=#C9D3DF;fontColor=#1F3A5F;fontSize=13;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760.0" y="534.0" width="700.0" height="34.0" as="geometry"/></mxCell><mxCell id="ej2a-A2-t3-p0" value="DEPENDE DE LA PK" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F1F4F7;strokeColor=#4A5A6A;fontColor=#4A5A6A;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="774.0" y="577.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej2a-A2-t3-f0" value="&lt;b&gt;(nro_reclamo, nro_paso)&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;cod_agente, fecha_paso, accion_realizada" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="914.0" y="572.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej2a-A2-t3-p1" value="PARCIAL · 2FN" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#FDF0E6;strokeColor=#C55A11;fontColor=#C55A11;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="774.0" y="607.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej2a-A2-t3-f1" value="&lt;b&gt;nro_reclamo&lt;/b&gt;&amp;nbsp;&amp;nb