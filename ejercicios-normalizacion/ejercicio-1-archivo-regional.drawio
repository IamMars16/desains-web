><mxCell id="ej1m-detalle_solicitud-r1-k" value="PK,FK" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=1;fontSize=11;fontColor=#C55A11;align=left;spacingLeft=8;overflow=hidden;html=1;whiteSpace=wrap;" vertex="1" parent="ej1m-detalle_solicitud-r1"><mxGeometry width="62" height="26" as="geometry"><mxRectangle width="62" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej1m-detalle_solicitud-r1-a" value="cod_documento" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=1;fontSize=12;fontColor=#1A1A1A;align=left;spacingLeft=6;overflow=hidden;html=1;whiteSpace=wrap;" vertex="1" parent="ej1m-detalle_solicitud-r1"><mxGeometry x="62" width="208" height="26" as="geometry"><mxRectangle width="208" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej1m-detalle_solicitud-r2" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;strokeColor=#1F3A5F;html=1;" vertex="1" parent="ej1m-detalle_solicitud"><mxGeometry y="82" width="270" height="26" as="geometry"/></mxCell><mxCell id="ej1m-detalle_solicitud-r2-k" value="" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=1;fontSize=11;fontColor=#2E75B6;align=left;spacingLeft=8;overflow=hidden;html=1;whiteSpace=wrap;" vertex="1" parent="ej1m-detalle_solicitud-r2"><mxGeometry width="62" height="26" as="geometry"><mxRectangle width="62" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej1m-detalle_solicitud-r2-a" value="nro_copias" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=0;fontSize=12;fontColor=#1A1A1A;align=left;spacingLeft=6;overflow=hidden;html=1;whiteSpace=wrap;" vertex="1" parent="ej1m-detalle_solicitud-r2"><mxGeometry x="62" width="208" height="26" as="geometry"><mxRectangle width="208" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej1m-detalle_solicitud-r3" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;strokeColor=#1F3A5F;html=1;" vertex="1" parent="ej1m-detalle_solicitud"><mxGeometry y="108" width="270" height="26" as="geometry"/></mxCell><mxCell id="ej1m-detalle_solicitud-r3-k" value="" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=1;fontSize=11;fontColor=#2E75B6;align=left;spacingLeft=8;overflow=hidden;html=1;whiteSpace=wrap;" vertex="1" parent="ej1m-detalle_solicitud-r3"><mxGeometry width="62" height="26" as="geometry"><mxRectangle width="62" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej1m-detalle_solicitud-r3-a" value="fecha_entrega" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=0;fontSize=12;fontColor=#1A1A1A;align=left;spacingLeft=6;overflow=hidden;html=1;whiteSpace=wrap;" vertex="1" parent="ej1m-detalle_solicitud-r3"><mxGeometry x="62" width="208" height="26" as="geometry"><mxRectangle width="208" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej1m-e0" value="REGISTRA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.2028;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5244;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej1m-solicitante" target="ej1m-telefono_solicitante"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej1m-e1" value="REALIZA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.2028;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2687;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej1m-solicitante" target="ej1m-solicitud"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej1m-e2" value="ATIENDE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.3981;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.2687;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej1m-funcionario" target="ej1m-solicitud"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej1m-e3" value="CONTIENE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej1m-solicitud" target="ej1m-detalle_solicitud"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej1m-e4" value="SE SOLICITA EN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.2312;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3209;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej1m-documento" target="ej1m-detalle_solicitud"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej1m-e5" value="ORGANIZA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5244;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2312;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej1m-fondo_documental" target="ej1m-documento"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej1m-legend" value="&lt;b style=&quot;color:#C55A11&quot;&gt;PK&lt;/b&gt; clave primaria &amp;nbsp;·&amp;nbsp; &lt;b style=&quot;color:#2E75B6&quot;&gt;FK&lt;/b&gt; clave foránea &amp;nbsp;·&amp;nbsp; &lt;b&gt;||&lt;/b&gt; = uno &amp;nbsp;·&amp;nbsp; pata de gallo = muchos" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="658" width="1530" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ej1-analisis" name="A1–A4 · Análisis"><mxGraphModel dx="1260" dy="852" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="852" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ej1a-title" value="Ejercicio 1 · Archivo Regional · control de solicitudes — Análisis (A1–A4)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej1a-A1-h" value="A1 · Atributos que violan la 1FN" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej1a-A1-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;SOLICITANTE.telefono1, telefono2, telefono3&lt;/b&gt; → grupo repetitivo. El mismo dato (teléfono) se repite en tres columnas: si el solicitante tiene menos teléfonos quedan columnas vacías y para buscar un número hay que revisar las tres. Solución: tabla &lt;b&gt;TELEFONO_SOLICITANTE(dni, telefono)&lt;/b&gt;, una fila por teléfono (máximo 3 por solicitante, según la regla de negocio).&lt;br&gt;•&amp;nbsp; &lt;b&gt;SOLICITANTE.direccion&lt;/b&gt; → no atómico. Guarda en un solo texto la calle, el distrito, la provincia y el departamento (&amp;quot;Jr. Amazonas 450, Cajamarca, Cajamarca, Cajamarca&amp;quot;). Solución: separar en &lt;b&gt;calle, distrito, provincia, departamento&lt;/b&gt;.&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1180" height="116" as="geometry"/></mxCell><mxCell id="ej1a-A2-h" value="A2 · Dependencias funcionales y dependencias parciales (2FN)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej1a-A2-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;SOLICITANTE:&lt;/b&gt; dni → nombres, apellidos, telefono1, telefono2, telefono3, direccion&lt;br&gt;•&amp;nbsp; &lt;b&gt;SOLICITUD:&lt;/b&gt; nro_solicitud → dni_solicitante, fecha_solicitud, estado, cod_funcionario, nombre_funcionario, cargo_funcionario  ·  cod_funcionario → nombre_funcionario, cargo_funcionario&lt;br&gt;•&amp;nbsp; &lt;b&gt;DOCUMENTO:&lt;/b&gt; cod_documento → tipo_documento, cod_fondo, nombre_fondo, anio_documento  ·  cod_fondo → nombre_fondo&lt;br&gt;•&amp;nbsp; &lt;b&gt;DETALLE_SOLICITUD:&lt;/b&gt; (nro_solicitud, cod_documento) → nro_copias, fecha_entrega  ·  cod_documento → descripcion_documento, ubicacion_fisica&lt;br&gt;•&amp;nbsp; &lt;b&gt;Dependencia parcial:&lt;/b&gt; en DETALLE_SOLICITUD, descripcion_documento y ubicacion_fisica dependen solo de cod_documento (una parte de la PK), porque cada documento tiene una única descripción y una única ubicación física. Se mueven a DOCUMENTO. SOLICITANTE, SOLICITUD y DOCUMENTO tienen PK simple, por eso no tienen dependencias parciales.&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="280" width="1180" height="170" as="geometry"/></mxCell><mxCell id="ej1a-A3-h" value="A3 · Dependencias transitivas (3FN) y atributos derivados" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="474" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej1a-A3-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;SOLICITUD:&lt;/b&gt; nro_solicitud → cod_funcionario → nombre_funcionario, cargo_funcionario. El nombre y el cargo dependen del funcionario, no de la solicitud. Se crea &lt;b&gt;FUNCIONARIO(cod_funcionario, nombre_funcionario, cargo_funcionario)&lt;/b&gt;.&lt;br&gt;•&amp;nbsp; &lt;b&gt;DOCUMENTO:&lt;/b&gt; cod_documento → cod_fondo → nombre_fondo. Se crea &lt;b&gt;FONDO_DOCUMENTAL(cod_fondo, nombre_fondo)&lt;/b&gt;.&lt;br&gt;•&amp;nbsp; &lt;b&gt;Atributos derivados:&lt;/b&gt; ninguno (no hay atributos que se calculen a partir de otros).&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="504" width="1180" height="98" as="geometry"/></mxCell><mxCell id="ej1a-A4-h" value="A4 · Dependencias funcionales del modelo corregido" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="626" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej1a-A4-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;SOLICITANTE:&lt;/b&gt; dni → nombres, apellidos, calle, distrito, provincia, departamento&lt;br&gt;•&amp;nbsp; &lt;b&gt;TELEFONO_SOLICITANTE:&lt;/b&gt; (dni, telefono) → clave completa (no tiene atributos no clave)&lt;br&gt;•&amp;nbsp; &lt;b&gt;FUNCIONARIO:&lt;/b&gt; cod_funcionario → nombre_funcionario, cargo_funcionario&lt;br&gt;•&amp;nbsp; &lt;b&gt;SOLICITUD:&lt;/b&gt; nro_solicitud → dni_solicitante, cod_funcionario, fecha_solicitud, estado&lt;br&gt;•&amp;nbsp; &lt;b&gt;FONDO_DOCUMENTAL:&lt;/b&gt; cod_fondo → nombre_fondo&lt;br&gt;•&amp;nbsp; &lt;b&gt;DOCUMENTO:&lt;/b&gt; cod_documento → cod_fondo, tipo_documento, descripcion_documento, ubicacion_fisica, anio_documento&lt;br&gt;•&amp;nbsp; &lt;b&gt;DETALLE_SOLICITUD:&lt;/b&gt; (nro_solicitud, cod_documento) → nro_copias, fecha_entrega&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="656" width="1180" height="152" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>