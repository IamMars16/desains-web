p;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontColor=#1A1A1A;fontSize=12;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340.0" y="204.0" width="170.0" height="50.0" as="geometry"/></mxCell><mxCell id="ej1a-A1-r0c1-p" value="GRUPO REPETITIVO" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#FDEDEC;strokeColor=#B03A2E;fontColor=#B03A2E;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="352.0" y="218.0" width="123.5" height="22.0" as="geometry"/></mxCell><mxCell id="ej1a-A1-r0c2" value="El mismo dato (teléfono) se repite en tres columnas; si el solicitante tiene menos teléfonos quedan columnas vacías." style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontColor=#1A1A1A;fontSize=12;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510.0" y="204.0" width="520.0" height="50.0" as="geometry"/></mxCell><mxCell id="ej1a-A1-r0c3" value="Nueva tabla &lt;b&gt;TELEFONO_SOLICITANTE&lt;/b&gt;(dni, telefono): una fila por teléfono, hasta 3 por solicitante." style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontColor=#1A1A1A;fontSize=12;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030.0" y="204.0" width="430.0" height="50.0" as="geometry"/></mxCell><mxCell id="ej1a-A1-r1c0" value="&lt;span style=&quot;font-size:10px;color:#5B6773&quot;&gt;SOLICITANTE&lt;/span&gt;&lt;br&gt;&lt;b&gt;direccion&lt;/b&gt;" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontColor=#1A1A1A;fontSize=12;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40.0" y="254.0" width="300.0" height="50.0" as="geometry"/></mxCell><mxCell id="ej1a-A1-r1c1" value="" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontColor=#1A1A1A;fontSize=12;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340.0" y="254.0" width="170.0" height="50.0" as="geometry"/></mxCell><mxCell id="ej1a-A1-r1c1-p" value="NO ATÓMICO" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#FDEDEC;strokeColor=#B03A2E;fontColor=#B03A2E;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="352.0" y="268.0" width="83.3" height="22.0" as="geometry"/></mxCell><mxCell id="ej1a-A1-r1c2" value="Guarda en un solo texto la calle, el distrito, la provincia y el departamento (&amp;quot;Jr. Amazonas 450, Cajamarca, Cajamarca, Cajamarca&amp;quot;)." style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontColor=#1A1A1A;fontSize=12;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510.0" y="254.0" width="520.0" height="50.0" as="geometry"/></mxCell><mxCell id="ej1a-A1-r1c3" value="Separar en &lt;b&gt;calle, distrito, provincia, departamento&lt;/b&gt;." style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontColor=#1A1A1A;fontSize=12;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030.0" y="254.0" width="430.0" height="50.0" as="geometry"/></mxCell><mxCell id="ej1a-A2" value="&lt;b&gt;A2&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;Dependencias funcionales y dependencias parciales (2FN)&lt;/b&gt;&lt;span style=&quot;color:#C9D6E5;font-weight:normal&quot;&gt;&amp;nbsp;&amp;nbsp;—&amp;nbsp;&amp;nbsp;por cada tabla original del enunciado&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=14;fillColor=#1F3A5F;strokeColor=none;fontColor=#FFFFFF;fontSize=14;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40.0" y="338.0" width="1420.0" height="36.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t0" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#C9D3DF;" vertex="1" parent="1"><mxGeometry x="40.0" y="386.0" width="700.0" height="102.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t0-h" value="&lt;b&gt;SOLICITANTE&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#5B6773;font-size:11px&quot;&gt;(tabla original) · PK simple: dni&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#EAF0F7;strokeColor=#C9D3DF;fontColor=#1F3A5F;fontSize=13;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40.0" y="386.0" width="700.0" height="34.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t0-p0" value="DEPENDE DE LA PK" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F1F4F7;strokeColor=#4A5A6A;fontColor=#4A5A6A;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54.0" y="429.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t0-f0" value="&lt;b&gt;dni&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;nombres, apellidos, telefono1, telefono2, telefono3, direccion" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="194.0" y="424.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t1" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#C9D3DF;" vertex="1" parent="1"><mxGeometry x="760.0" y="386.0" width="700.0" height="102.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t1-h" value="&lt;b&gt;SOLICITUD&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#5B6773;font-size:11px&quot;&gt;(tabla original) · PK simple: nro_solicitud&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#EAF0F7;strokeColor=#C9D3DF;fontColor=#1F3A5F;fontSize=13;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760.0" y="386.0" width="700.0" height="34.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t1-p0" value="DEPENDE DE LA PK" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F1F4F7;strokeColor=#4A5A6A;fontColor=#4A5A6A;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="774.0" y="429.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t1-f0" value="&lt;b&gt;nro_solicitud&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;dni_solicitante, fecha_solicitud, estado, cod_funcionario" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="914.0" y="424.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t1-p1" value="TRANSITIVA · 3FN" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F4ECF7;strokeColor=#6C3483;fontColor=#6C3483;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="774.0" y="459.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t1-f1" value="&lt;b&gt;cod_funcionario&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;nombre_funcionario, cargo_funcionario" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="914.0" y="454.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t2" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#C9D3DF;" vertex="1" parent="1"><mxGeometry x="40.0" y="504.0" width="700.0" height="102.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t2-h" value="&lt;b&gt;DOCUMENTO&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#5B6773;font-size:11px&quot;&gt;(tabla original) · PK simple: cod_documento&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#EAF0F7;strokeColor=#C9D3DF;fontColor=#1F3A5F;fontSize=13;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40.0" y="504.0" width="700.0" height="34.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t2-p0" value="DEPENDE DE LA PK" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F1F4F7;strokeColor=#4A5A6A;fontColor=#4A5A6A;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54.0" y="547.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t2-f0" value="&lt;b&gt;cod_documento&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;tipo_documento, cod_fondo, anio_documento" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="194.0" y="542.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t2-p1" value="TRANSITIVA · 3FN" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F4ECF7;strokeColor=#6C3483;fontColor=#6C3483;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54.0" y="577.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t2-f1" value="&lt;b&gt;cod_fondo&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;nombre_fondo" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="194.0" y="572.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t3" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#C9D3DF;" vertex="1" parent="1"><mxGeometry x="760.0" y="504.0" width="700.0" height="102.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t3-h" value="&lt;b&gt;DETALLE_SOLICITUD&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#5B6773;font-size:11px&quot;&gt;(tabla original) · PK compuesta: (nro_solicitud, cod_documento)&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#EAF0F7;strokeColor=#C9D3DF;fontColor=#1F3A5F;fontSize=13;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760.0" y="504.0" width="700.0" height="34.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t3-p0" value="DEPENDE DE LA PK" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F1F4F7;strokeColor=#4A5A6A;fontColor=#4A5A6A;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="774.0" y="547.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t3-f0" value="&lt;b&gt;(nro_solicitud, cod_documento)&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;nro_copias, fecha_entrega" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="914.0" y="542.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t3-p1" value="PARCIAL · 2FN" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#FDF0E6;strokeColor=#C55A11;fontColor=#C55A11;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="774.0" y="577.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-t3-f1" value="&lt;b&gt;cod_documento&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;descripcion_documento, ubicacion_fisica" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="914.0" y="572.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej1a-A2-c" value="&lt;b&gt;Dependencia parcial:&lt;/b&gt; en DETALLE_SOLICITUD, descripcion_documento y ubicacion_fisica dependen solo de cod_documento (cada documento tiene una única descripción y una única ubicación física). &lt;b&gt;Se mueven a DOCUMENTO.&lt;/b&gt; Las otras tres tablas tienen PK simple, por eso no pueden tener dependencias parciales." style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#FDF0E6;strokeColor=#C55A11;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="40.0" y="622.0" width="1420.0" height="54.0" as="geometry"/></mxCell><mxCell id="ej1a-A3" value="&lt;b&gt;A3&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;Dependencias transitivas (3FN) y atributos derivados&lt;/b&gt;&lt;span style=&quot;color:#C9D6E5;font-weight:normal&quot;&gt;&amp;nbsp;&amp;nbsp;—&amp;nbsp;&amp;nbsp;un atributo no clave depende de otro atributo no clave · atributos que se calculan&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=14;fillColor=#1F3A5F;strokeColor=none;fontColor=#FFFFFF;fontSize=14;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40.0" y="710.0" width="1420.0" height="36.0" as="geometry"/></mxCell><mxCell id="ej1a-A3-i0" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C9D3DF;" vertex="1" parent="1"><mxGeometry x="40.0" y="758.0" width="1420.0" height="83.0" as="geometry"/></mxCell><mxCell id="ej1a-A3-i0-t" value="SOLICITUD" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="54.0" y="770.0" width="170.0" height="22.0" as="geometry"/></mxCell><mxCell id="ej1a-A3-i0-k" value="TRANSITIVA · 3FN" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F4ECF7;strokeColor=#6C3483;fontColor=#6C3483;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54.0" y="796.0" width="115.4" height="20.0" as="geometry"/></mxCell><mxCell id="ej1a-A3-i0-n0" value="nro_solicitud" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#EAF0F7;strokeColor=#1F3A5F;fontStyle=1;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="772.0" width="114.4" height="30.0" as="geometry"/></mxCell><mxCell id="ej1a-A3-i0-n1" value="cod_funcionario" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#F4ECF7;strokeColor=#6C3483;fontStyle=1;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="388.4" y="772.0" width="127.7" height="30.0" as="geometry"/></mxCell><mxCell id="ej1a-A3-i0-n1-a" value="" style="endArrow=block;endFill=1;endSize=7;html=1;strokeColor=#1F3A5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej1a-A3-i0-n0" target="ej1a-A3-i0-n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ej1a-A3-i0-n2" value="nombre_funcionario, cargo_funcionario" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#6C3483;fontStyle=0;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="560.2" y="772.0" width="271.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej1a-A3-i0-n2-a" value="" style="endArrow=block;endFill=1;endSize=7;html=1;strokeColor=#1F3A5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej1a-A3-i0-n1" target="ej1a-A3-i0-n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ej1a-A3-i0-r" value="Nueva tabla:&amp;nbsp;FUNCIONARIO(cod_funcionario, nombre_funcionario, cargo_funcionario)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="885.1" y="772.0" width="557.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej1a-A3-i0-ra" value="" style="endArrow=open;endFill=1;endSize=7;html=1;strokeColor=#1F3A5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="ej1a-A3-i0-n2" target="ej1a-A3-i0-r"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ej1a-A3-i0-nota" value="El nombre y el cargo dependen del funcionario, no de la solicitud; un funcionario atiende muchas solicitudes." style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=11;fontColor=#5B6773;" vertex="1" parent="1"><mxGeometry x="230.0" y="812.0" width="1210.0" height="19.0" as="geometry"/></mxCell><mxCell id="ej1a-A3-i1" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C9D3DF;" vertex="1" parent="1"><mxGeometry x="40.0" y="853.0" width="1420.0" height="83.0" as="geometry"/></mxCell><mxCell id="ej1a-A3-i1-t" value="DOCUMENTO" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="54.0" y="865.0" width="170.0" height="22.0" as="geometry"/></mxCell><mxCell id="ej1a-A3-i1-k" value="TRANSITIVA · 3FN" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F4ECF7;strokeColor=#6C3483;fontColor=#6C3483;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54.0" y="891.0" width="115.4" height="20.0" as="geometry"/></mxCell><mxCell id="ej1a-A3-i1-n0" value="cod_documento" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#EAF0F7;strokeColor=#1F3A5F;fontStyle=1;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="867.0" width="117.7" height="30.0" as="geometry"/></mxCell><mxCell id="ej1a-A3-i1-n1" value="cod_fondo" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#F4ECF7;strokeColor=#6C3483;fontStyle=1;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="391.7" y="867.0" width="87.8" height="30.0" as="geometry"/></mxCell><mxCell id="ej1a-A3-i1-n1-a" value="" style="endArrow=block;endFill=1;endSize=7;html=1;strokeColor=#1F3A5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" 