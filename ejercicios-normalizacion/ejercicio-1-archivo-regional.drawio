" as="geometry"/></mxCell><mxCell id="ej1a-a1-0" value="telefono1, telefono2, telefono3  (SOLICITANTE)" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="116" width="668" height="88" as="geometry"/></mxCell><mxCell id="ej1a-a1-0-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;&lt;b&gt;Grupo repetitivo:&lt;/b&gt; el teléfono se repite en tres columnas.&lt;br&gt;→ tabla &lt;b&gt;TELEFONO_SOLICITANTE&lt;/b&gt;(dni, telefono), máximo 3 por solicitante&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej1a-a1-0"><mxGeometry x="0" y="32" width="668" height="56" as="geometry"/></mxCell><mxCell id="ej1a-a1-1" value="direccion  (SOLICITANTE)" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="752" y="116" width="668" height="88" as="geometry"/></mxCell><mxCell id="ej1a-a1-1-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;&lt;b&gt;No atómico:&lt;/b&gt; guarda calle, distrito, provincia y departamento en un solo texto.&lt;br&gt;→ separar en &lt;b&gt;calle, distrito, provincia, departamento&lt;/b&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej1a-a1-1"><mxGeometry x="0" y="32" width="668" height="56" as="geometry"/></mxCell><mxCell id="ej1a-p2" value="" style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#FAFAFA;strokeColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="1400" height="304" as="geometry"/></mxCell><mxCell id="ej1a-p2-cap" value="A2. Dependencias funcionales y dependencias parciales (2FN)" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="58" y="260" width="1364" height="24" as="geometry"/></mxCell><mxCell id="ej1a-a2-0" value="SOLICITANTE" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="292" width="668" height="88" as="geometry"/></mxCell><mxCell id="ej1a-a2-0-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;dni → nombres, apellidos, telefono1, telefono2, telefono3, direccion&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej1a-a2-0"><mxGeometry x="0" y="32" width="668" height="56" as="geometry"/></mxCell><mxCell id="ej1a-a2-1" value="SOLICITUD" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="752" y="292" width="668" height="88" as="geometry"/></mxCell><mxCell id="ej1a-a2-1-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;nro_solicitud → dni_solicitante, fecha_solicitud, estado, cod_funcionario&lt;br&gt;cod_funcionario → nombre_funcionario, cargo_funcionario &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(transitiva)&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej1a-a2-1"><mxGeometry x="0" y="32" width="668" height="56" as="geometry"/></mxCell><mxCell id="ej1a-a2-2" value="DOCUMENTO" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="404" width="668" height="88" as="geometry"/></mxCell><mxCell id="ej1a-a2-2-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;cod_documento → tipo_documento, cod_fondo, anio_documento&lt;br&gt;cod_fondo → nombre_fondo &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(transitiva)&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej1a-a2-2"><mxGeometry x="0" y="32" width="668" height="56" as="geometry"/></mxCell><mxCell id="ej1a-a2-3" value="DETALLE_SOLICITUD" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="752" y="404" width="668" height="88" as="geometry"/></mxCell><mxCell id="ej1a-a2-3-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;(nro_solicitud, cod_documento) → nro_copias, fecha_entrega&lt;br&gt;cod_documento → descripcion_documento, ubicacion_fisica &lt;font color=&quot;#C0392B&quot;&gt;&lt;b&gt;(parcial)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej1a-a2-3"><mxGeometry x="0" y="32" width="668" height="56" as="geometry"/></mxCell><mxCell id="ej1a-a2c" value="&lt;b&gt;Parcial:&lt;/b&gt; en DETALLE_SOLICITUD, descripcion_documento y ubicacion_fisica dependen solo de cod_documento, así que pasan a DOCUMENTO. Las otras tablas tienen PK simple." style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=12;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="60" y="506" width="1360" height="26" as="geometry"/></mxCell><mxCell id="ej1a-p3" value="" style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#FAFAFA;strokeColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="40" y="578" width="1400" height="246" as="geometry"/></mxCell><mxCell id="ej1a-p3-cap" value="A3. Dependencias transitivas (3FN) y atributos derivados" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="58" y="588" width="1364" height="24" as="geometry"/></mxCell><mxCell id="ej1a-a3-0" value="SOLICITUD" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="668" height="88" as="geometry"/></mxCell><mxCell id="ej1a-a3-0-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;nro_solicitud → cod_funcionario → nombre_funcionario, cargo_funcionario&lt;br&gt;→ nueva tabla &lt;b&gt;FUNCIONARIO&lt;/b&gt;(cod_funcionario, nombre_funcionario, cargo_funcionario)&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej1a-a3-0"><mxGeometry x="0" y="32" width="668" height="56" as="geometry"/></mxCell><mxCell id="ej1a-a3-1" value="DOCUMENTO" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;str