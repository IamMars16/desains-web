74.0" width="300.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A1-h1" value="Problema" style="html=1;whiteSpace=wrap;fillColor=#EAF0F7;strokeColor=#C9D3DF;fontColor=#1F3A5F;fontStyle=1;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340.0" y="174.0" width="170.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A1-h2" value="Por qué viola la 1FN" style="html=1;whiteSpace=wrap;fillColor=#EAF0F7;strokeColor=#C9D3DF;fontColor=#1F3A5F;fontStyle=1;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510.0" y="174.0" width="520.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A1-h3" value="Solución" style="html=1;whiteSpace=wrap;fillColor=#EAF0F7;strokeColor=#C9D3DF;fontColor=#1F3A5F;fontStyle=1;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030.0" y="174.0" width="430.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A1-r0c0" value="&lt;span style=&quot;font-size:10px;color:#5B6773&quot;&gt;MATRICULA&lt;/span&gt;&lt;br&gt;&lt;b&gt;nota1, nota2, nota3&lt;/b&gt;" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontColor=#1A1A1A;fontSize=12;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40.0" y="204.0" width="300.0" height="50.0" as="geometry"/></mxCell><mxCell id="ej5a-A1-r0c1" value="" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontColor=#1A1A1A;fontSize=12;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="340.0" y="204.0" width="170.0" height="50.0" as="geometry"/></mxCell><mxCell id="ej5a-A1-r0c1-p" value="GRUPO REPETITIVO" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#FDEDEC;strokeColor=#B03A2E;fontColor=#B03A2E;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="352.0" y="218.0" width="123.5" height="22.0" as="geometry"/></mxCell><mxCell id="ej5a-A1-r0c2" value="El mismo dato (nota parcial) se repite en tres columnas." style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontColor=#1A1A1A;fontSize=12;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="510.0" y="204.0" width="520.0" height="50.0" as="geometry"/></mxCell><mxCell id="ej5a-A1-r0c3" value="Nueva tabla &lt;b&gt;NOTA_PARCIAL&lt;/b&gt;(cod_alumno, cod_curso, nro_parcial, nota): una fila por nota; nro_parcial = 1, 2 o 3." style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontColor=#1A1A1A;fontSize=12;align=left;spacingLeft=12;spacingRight=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1030.0" y="204.0" width="430.0" height="50.0" as="geometry"/></mxCell><mxCell id="ej5a-A2" value="&lt;b&gt;A2&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;Dependencias funcionales y dependencias parciales (2FN)&lt;/b&gt;&lt;span style=&quot;color:#C9D6E5;font-weight:normal&quot;&gt;&amp;nbsp;&amp;nbsp;—&amp;nbsp;&amp;nbsp;por cada tabla original del enunciado&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=14;fillColor=#1F3A5F;strokeColor=none;fontColor=#FFFFFF;fontSize=14;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40.0" y="288.0" width="1420.0" height="36.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t0" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#C9D3DF;" vertex="1" parent="1"><mxGeometry x="40.0" y="336.0" width="700.0" height="132.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t0-h" value="&lt;b&gt;ALUMNO&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#5B6773;font-size:11px&quot;&gt;(tabla original) · PK simple: cod_alumno&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#EAF0F7;strokeColor=#C9D3DF;fontColor=#1F3A5F;fontSize=13;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40.0" y="336.0" width="700.0" height="34.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t0-p0" value="DEPENDE DE LA PK" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F1F4F7;strokeColor=#4A5A6A;fontColor=#4A5A6A;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54.0" y="379.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t0-f0" value="&lt;b&gt;cod_alumno&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;nombres, apellidos, fecha_nacimiento, correo, cod_escuela" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="194.0" y="374.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t0-p1" value="TRANSITIVA · 3FN" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F4ECF7;strokeColor=#6C3483;fontColor=#6C3483;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54.0" y="409.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t0-f1" value="&lt;b&gt;cod_escuela&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;nombre_escuela" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="194.0" y="404.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t0-p2" value="DERIVADO" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#E9F7EF;strokeColor=#1E8449;fontColor=#1E8449;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54.0" y="439.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t0-f2" value="&lt;b&gt;fecha_nacimiento&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;edad" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="194.0" y="434.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t1" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#C9D3DF;" vertex="1" parent="1"><mxGeometry x="760.0" y="336.0" width="700.0" height="132.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t1-h" value="&lt;b&gt;MATRICULA&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#5B6773;font-size:11px&quot;&gt;(tabla original) · PK compuesta: (cod_alumno, cod_curso)&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#EAF0F7;strokeColor=#C9D3DF;fontColor=#1F3A5F;fontSize=13;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760.0" y="336.0" width="700.0" height="34.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t1-p0" value="DEPENDE DE LA PK" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F1F4F7;strokeColor=#4A5A6A;fontColor=#4A5A6A;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="774.0" y="379.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t1-f0" value="&lt;b&gt;(cod_alumno, cod_curso)&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;docente, semestre, nota1, nota2, nota3" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="914.0" y="374.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t1-p1" value="FNBC (BCNF)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#E6F4F6;strokeColor=#117A8B;fontColor=#117A8B;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="774.0" y="409.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t1-f1" value="&lt;b&gt;docente&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;cod_curso" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="914.0" y="404.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t1-p2" value="DERIVADO" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#E9F7EF;strokeColor=#1E8449;fontColor=#1E8449;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="774.0" y="439.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t1-f2" value="&lt;b&gt;nota1, nota2, nota3&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;promedio" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="914.0" y="434.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t2" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#C9D3DF;" vertex="1" parent="1"><mxGeometry x="40.0" y="484.0" width="700.0" height="72.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t2-h" value="&lt;b&gt;CURSO&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#5B6773;font-size:11px&quot;&gt;(tabla original) · PK simple: cod_curso&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#EAF0F7;strokeColor=#C9D3DF;fontColor=#1F3A5F;fontSize=13;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40.0" y="484.0" width="700.0" height="34.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t2-p0" value="DEPENDE DE LA PK" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F1F4F7;strokeColor=#4A5A6A;fontColor=#4A5A6A;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54.0" y="527.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-t2-f0" value="&lt;b&gt;cod_curso&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;nombre_curso, creditos" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="194.0" y="522.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A2-c" value="&lt;b&gt;No hay dependencias parciales.&lt;/b&gt; En MATRICULA ningún atributo no clave depende solo de cod_alumno o solo de cod_curso: el docente no depende solo del curso, porque un mismo curso puede ser dictado por varios docentes. ALUMNO y CURSO tienen PK simple." style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#F1F4F7;strokeColor=#4A5A6A;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="40.0" y="572.0" width="1420.0" height="54.0" as="geometry"/></mxCell><mxCell id="ej5a-A3" value="&lt;b&gt;A3&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;Dependencias transitivas (3FN) y atributos derivados&lt;/b&gt;&lt;span style=&quot;color:#C9D6E5;font-weight:normal&quot;&gt;&amp;nbsp;&amp;nbsp;—&amp;nbsp;&amp;nbsp;un atributo no clave depende de otro atributo no clave · atributos que se calculan&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=14;fillColor=#1F3A5F;strokeColor=none;fontColor=#FFFFFF;fontSize=14;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40.0" y="660.0" width="1420.0" height="36.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i0" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C9D3DF;" vertex="1" parent="1"><mxGeometry x="40.0" y="708.0" width="1420.0" height="83.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i0-t" value="ALUMNO" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="54.0" y="720.0" width="170.0" height="22.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i0-k" value="TRANSITIVA · 3FN" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F4ECF7;strokeColor=#6C3483;fontColor=#6C3483;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54.0" y="746.0" width="115.4" height="20.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i0-n0" value="cod_alumno" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#EAF0F7;strokeColor=#1F3A5F;fontStyle=1;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="722.0" width="97.8" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i0-n1" value="cod_escuela" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#F4ECF7;strokeColor=#6C3483;fontStyle=1;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="371.8" y="722.0" width="101.1" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i0-n1-a" value="" style="endArrow=block;endFill=1;endSize=7;html=1;strokeColor=#1F3A5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej5a-A3-i0-n0" target="ej5a-A3-i0-n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ej5a-A3-i0-n2" value="nombre_escuela" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#6C3483;fontStyle=0;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="516.9" y="722.0" width="124.3" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i0-n2-a" value="" style="endArrow=block;endFill=1;endSize=7;html=1;strokeColor=#1F3A5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej5a-A3-i0-n1" target="ej5a-A3-i0-n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ej5a-A3-i0-r" value="Nueva tabla:&amp;nbsp;ESCUELA(cod_escuela, nombre_escuela)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="695.2" y="722.0" width="351.6" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i0-ra" value="" style="endArrow=open;endFill=1;endSize=7;html=1;strokeColor=#1F3A5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="ej5a-A3-i0-n2" target="ej5a-A3-i0-r"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ej5a-A3-i0-nota" value="Cada escuela tiene un código único y un nombre." style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=11;fontColor=#5B6773;" vertex="1" parent="1"><mxGeometry x="230.0" y="762.0" width="1210.0" height="19.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i1" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C9D3DF;" vertex="1" parent="1"><mxGeometry x="40.0" y="803.0" width="1420.0" height="98.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i1-t" value="MATRICULA" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="54.0" y="815.0" width="170.0" height="22.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i1-k" value="FNBC (BCNF)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#E6F4F6;strokeColor=#117A8B;fontColor=#117A8B;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54.0" y="841.0" width="81.6" height="20.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i1-n0" value="(cod_alumno, cod_curso)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#EAF0F7;strokeColor=#1F3A5F;fontStyle=1;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="817.0" width="173.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i1-n1" value="docente" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#E6F4F6;strokeColor=#117A8B;fontStyle=1;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="447.0" y="817.0" width="74.5" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i1-n1-a" value="" style="endArrow=block;endFill=1;endSize=7;html=1;strokeColor=#1F3A5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej5a-A3-i1-n0" target="ej5a-A3-i1-n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ej5a-A3-i1-n2" value="cod_curso" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#117A8B;fontStyle=0;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="565.5" y="817.0" width="87.8" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i1-n2-a" value="" style="endArrow=block;endFill=1;endSize=7;html=1;strokeColor=#1F3A5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej5a-A3-i1-n1" target="ej5a-A3-i1-n2"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ej5a-A3-i1-r" value="Nueva tabla:&amp;nbsp;DOCENTE(docente, cod_curso)" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="707.4" y="817.0" width="288.5" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i1-ra" value="" style="endArrow=open;endFill=1;endSize=7;html=1;strokeColor=#1F3A5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="ej5a-A3-i1-n2" target="ej5a-A3-i1-r"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ej5a-A3-i1-nota" value="Cada docente dicta un único curso. Como cod_curso es parte de la PK, no es transitiva en sentido estricto: es el caso que revisa la FNBC. MATRICULA mantiene su PK (el alumno se matricula en un curso una sola vez) y docente queda como FK." style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=11;fontColor=#5B6773;" vertex="1" parent="1"><mxGeometry x="230.0" y="857.0" width="1210.0" height="34.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i2" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C9D3DF;" vertex="1" parent="1"><mxGeometry x="40.0" y="913.0" width="1420.0" height="83.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i2-t" value="ALUMNO" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="54.0" y="925.0" width="170.0" height="22.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i2-k" value="DERIVADO" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#E9F7EF;strokeColor=#1E8449;fontColor=#1E8449;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54.0" y="951.0" width="71.7" height="20.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i2-n0" value="fecha_nacimiento" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontStyle=0;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="927.0" width="137.6" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i2-n1" value="edad" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#E9F7EF;strokeColor=#1E8449;fontStyle=1;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="411.6" y="927.0" width="54.6" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i2-n1-a" value="" style="endArrow=block;endFill=1;endSize=7;html=1;strokeColor=#1F3A5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej5a-A3-i2-n0" target="ej5a-A3-i2-n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ej5a-A3-i2-r" value="Se elimina: se calcula" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#B03A2E;dashed=1;fontColor=#B03A2E;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="520.2" y="927.0" width="170.3" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i2-ra" value="" style="endArrow=open;endFill=1;endSize=7;html=1;strokeColor=#1F3A5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="ej5a-A3-i2-n1" target="ej5a-A3-i2-r"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ej5a-A3-i2-nota" value="La edad se calcula a partir de fecha_nacimiento." style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=11;fontColor=#5B6773;" vertex="1" parent="1"><mxGeometry x="230.0" y="967.0" width="1210.0" height="19.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i3" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C9D3DF;" vertex="1" parent="1"><mxGeometry x="40.0" y="1008.0" width="1420.0" height="83.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i3-t" value="MATRICULA" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="54.0" y="1020.0" width="170.0" height="22.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i3-k" value="DERIVADO" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#E9F7EF;strokeColor=#1E8449;fontColor=#1E8449;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54.0" y="1046.0" width="71.7" height="20.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i3-n0" value="nota1, nota2, nota3" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontStyle=0;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="1022.0" width="141.7" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i3-n1" value="promedio" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#E9F7EF;strokeColor=#1E8449;fontStyle=1;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="415.7" y="1022.0" width="84.5" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i3-n1-a" value="" style="endArrow=block;endFill=1;endSize=7;html=1;strokeColor=#1F3A5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej5a-A3-i3-n0" target="ej5a-A3-i3-n1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ej5a-A3-i3-r" value="Se elimina: se calcula" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#B03A2E;dashed=1;fontColor=#B03A2E;fontStyle=1;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="554.2" y="1022.0" width="170.3" height="30.0" as="geometry"/></mxCell><mxCell id="ej5a-A3-i3-ra" value="" style="endArrow=open;endFill=1;endSize=7;html=1;strokeColor=#1F3A5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;" edge="1" parent="1" source="ej5a-A3-i3-n1" target="ej5a-A3-i3-r"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="ej5a-A3-i3-nota" value="El promedio se calcula con las tres notas parciales (ahora en NOTA_PARCIAL)." style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=11;fontColor=#5B6773;" vertex="1" parent="1"><mxGeometry x="230.0" y="1062.0" width="1210.0" height="19.0" as="geometry"/></mxCell><mxCell id="ej5a-A4" value="&lt;b&gt;A4&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;Dependencias funcionales del modelo corregido&lt;/b&gt;&lt;span style=&quot;color:#C9D6E5;font-weight:normal&quot;&gt;&amp;nbsp;&amp;nbsp;—&amp;nbsp;&amp;nbsp;en cada tabla final la PK determina todo lo demás&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=14;fillColor=#1F3A5F;strokeColor=none;fontColor=#FFFFFF;fontSize=14;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40.0" y="1125.0" width="1420.0" height="36.0" as="geometry"/></mxCell><mxCell id="ej5a-A4-escuela-h" value="ESCUELA" style="html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40.0" y="1173.0" width="340.0" height="28.0" as="geometry"/></mxCell><mxCell id="ej5a-A4-escuela-b" value="&lt;b&gt;cod_escuela&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;nombre_escuela" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="40.0" y="1201.0" width="340.0" height="54.0" as="geometry"/></mxCell><mxCell id="ej5a-A4-alumno-h" value="ALUMNO" style="html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400.0" y="1173.0" width="340.0" height="28.0" as="geometry"/></mxCell><mxCell id="ej5a-A4-alumno-b" value="&lt;b&gt;cod_alumno&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;cod_escuela, nombres, apellidos, fecha_nacimiento, correo" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="400.0" y="1201.0" width="340.0" height="54.0" as="geometry"/></mxCell><mxCell id="ej5a-A4-curso-h" value="CURSO" style="html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760.0" y="1173.0" width="340.0" height="28.0" as="geometry"/></mxCell><mxCell id="ej5a-A4-curso-b" value="&lt;b&gt;cod_curso&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;nombre_curso, creditos" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="760.0" y="1201.0" width="340.0" height="54.0" as="geometry"/></mxCell><mxCell id="ej5a-A4-docente-h" value="DOCENTE" style="html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1120.0" y="1173.0" width="340.0" height="28.0" as="geometry"/></mxCell><mxCell id="ej5a-A4-docente-b" value="&lt;b&gt;docente&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;cod_curso" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="1120.0" y="1201.0" width="340.0" height="54.0" as="geometry"/></mxCell><mxCell id="ej5a-A4-matricula-h" value="MATRICULA" style="html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40.0" y="1269.0" width="340.0" height="28.0" as="geometry"/></mxCell><mxCell id="ej5a-A4-matricula-b" value="&lt;b&gt;(cod_alumno, cod_curso)&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;docente, semestre" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="40.0" y="1297.0" width="340.0" height="38.0" as="geometry"/></mxCell><mxCell id="ej5a-A4-nota_parcial-h" value="NOTA_PARCIAL" style="html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400.0" y="1269.0" width="340.0" height="28.0" as="geometry"/></mxCell><mxCell id="ej5a-A4-nota_parcial-b" value="&lt;b&gt;(cod_alumno, cod_curso, nro_parcial)&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;nota" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="400.0" y="1297.0" width="340.0" height="38.0" as="geometry"/></mxCell><mxCell id="ej5a-A4-nota" value="&lt;b&gt;Regla a validar:&lt;/b&gt; como MATRICULA guarda cod_curso y docente, al registrar una matrícula se debe comprobar que el docente dicte ese curso (DOCENTE.cod_curso = MATRICULA.cod_curso)." style="html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=#F1F4F7;strokeColor=#C9D3DF;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="40.0" y="1353.0" width="1420.0" height="34.0" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>