ight="26" as="geometry"><mxRectangle width="62" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej5m-docente-r1-a" value="cod_curso" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=0;fontSize=12;fontColor=#1A1A1A;align=left;spacingLeft=6;overflow=hidden;html=1;whiteSpace=wrap;" vertex="1" parent="ej5m-docente-r1"><mxGeometry x="62" width="208" height="26" as="geometry"><mxRectangle width="208" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej5m-e0" value="PERTENECE A" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5244;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2312;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej5m-escuela" target="ej5m-alumno"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej5m-e1" value="REALIZA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.2312;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3209;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej5m-alumno" target="ej5m-matricula"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej5m-e2" value="SE DICTA EN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.3981;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3209;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej5m-curso" target="ej5m-matricula"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej5m-e3" value="REGISTRA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej5m-matricula" target="ej5m-nota_parcial"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej5m-e4" value="DICTA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej5m-curso" target="ej5m-docente"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej5m-e5" value="CURSA CON" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.5244;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.7090;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej5m-docente" target="ej5m-matricula"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="1225.0" y="449.0"/><mxPoint x="1225.0" y="215.0"/></Array></mxGeometry></mxCell><mxCell id="ej5m-legend" value="&lt;b style=&quot;color:#C55A11&quot;&gt;PK&lt;/b&gt; clave primaria &amp;nbsp;·&amp;nbsp; &lt;b style=&quot;color:#2E75B6&quot;&gt;FK&lt;/b&gt; clave foránea &amp;nbsp;·&amp;nbsp; &lt;b&gt;||&lt;/b&gt; = uno &amp;nbsp;·&amp;nbsp; pata de gallo = muchos" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="1530" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ej5-analisis" name="A1–A4 · Análisis"><mxGraphModel dx="1260" dy="744" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="744" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ej5a-title" value="Ejercicio 5 · Sistema académico · matrícula y notas — Análisis (A1–A4)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej5a-A1-h" value="A1 · Atributos que violan la 1FN" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej5a-A1-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;MATRICULA.nota1, nota2, nota3&lt;/b&gt; → grupo repetitivo. El mismo dato (nota parcial) se repite en tres columnas. Solución: tabla &lt;b&gt;NOTA_PARCIAL(cod_alumno, cod_curso, nro_parcial, nota)&lt;/b&gt;, una fila por nota; nro_parcial toma los valores 1, 2 y 3 (nota1, nota2, nota3).&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1180" height="62" as="geometry"/></mxCell><mxCell id="ej5a-A2-h" value="A2 · Dependencias funcionales y dependencias parciales (2FN)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej5a-A2-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;ALUMNO:&lt;/b&gt; cod_alumno → nombres, apellidos, fecha_nacimiento, edad, correo, cod_escuela, nombre_escuela  ·  cod_escuela → nombre_escuela  ·  fecha_nacimiento → edad&lt;br&gt;•&amp;nbsp; &lt;b&gt;MATRICULA:&lt;/b&gt; (cod_alumno, cod_curso) → docente, semestre, nota1, nota2, nota3, promedio  ·  docente → cod_curso  ·  (nota1, nota2, nota3) → promedio&lt;br&gt;•&amp;nbsp; &lt;b&gt;CURSO:&lt;/b&gt; cod_curso → nombre_curso, creditos&lt;br&gt;•&amp;nbsp; &lt;b&gt;Dependencias parciales:&lt;/b&gt; ninguna. En MATRICULA ningún atributo no clave depende solo de cod_alumno o solo de cod_curso (el docente no depende solo del curso, porque un mismo curso puede ser dictado por varios docentes). ALUMNO y CURSO tienen PK simple.&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="1180" height="116" as="geometry"/></mxCell><mxCell id="ej5a-A3-h" value="A3 · Dependencias transitivas (3FN) y atributos derivados" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="366" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej5a-A3-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;ALUMNO:&lt;/b&gt; cod_alumno → cod_escuela → nombre_escuela. Se crea &lt;b&gt;ESCUELA(cod_escuela, nombre_escuela)&lt;/b&gt;.&lt;br&gt;•&amp;nbsp; &lt;b&gt;MATRICULA:&lt;/b&gt; docente → cod_curso (cada docente dicta un único curso). Se crea &lt;b&gt;DOCENTE(docente, cod_curso)&lt;/b&gt; para guardar una sola vez qué curso dicta cada docente; en MATRICULA, docente queda como FK. La PK de MATRICULA sigue siendo (cod_alumno, cod_curso) porque el alumno se matricula en un curso una sola vez. (Como cod_curso es parte de la PK, esta dependencia no es transitiva en sentido estricto; es el caso que revisa la FNBC.)&lt;br&gt;•&amp;nbsp; &lt;b&gt;Atributos derivados (se eliminan y se calculan en la consulta):&lt;/b&gt; edad (se calcula con fecha_nacimiento) y promedio (se calcula con las tres notas parciales).&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="396" width="1180" height="116" as="geometry"/></mxCell><mxCell id="ej5a-A4-h" value="A4 · Dependencias funcionales del modelo corregido" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="536" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej5a-A4-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;ESCUELA:&lt;/b&gt; cod_escuela → nombre_escuela&lt;br&gt;•&amp;nbsp; &lt;b&gt;ALUMNO:&lt;/b&gt; cod_alumno → nombres, apellidos, fecha_nacimiento, correo, cod_escuela&lt;br&gt;•&amp;nbsp; &lt;b&gt;CURSO:&lt;/b&gt; cod_curso → nombre_curso, creditos&lt;br&gt;•&amp;nbsp; &lt;b&gt;DOCENTE:&lt;/b&gt; docente → cod_curso&lt;br&gt;•&amp;nbsp; &lt;b&gt;MATRICULA:&lt;/b&gt; (cod_alumno, cod_curso) → docente, semestre&lt;br&gt;•&amp;nbsp; &lt;b&gt;NOTA_PARCIAL:&lt;/b&gt; (cod_alumno, cod_curso, nro_parcial) → nota&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="566" width="1180" height="134" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>