d_alumno, cod_curso, nro_parcial, nota), nro_parcial = 1, 2, 3&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej5a-a1-0"><mxGeometry x="0" y="32" width="668" height="56" as="geometry"/></mxCell><mxCell id="ej5a-p2" value="" style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#FAFAFA;strokeColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="1400" height="304" as="geometry"/></mxCell><mxCell id="ej5a-p2-cap" value="A2. Dependencias funcionales y dependencias parciales (2FN)" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="58" y="260" width="1364" height="24" as="geometry"/></mxCell><mxCell id="ej5a-a2-0" value="ALUMNO" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="292" width="668" height="106" as="geometry"/></mxCell><mxCell id="ej5a-a2-0-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;cod_alumno → nombres, apellidos, fecha_nacimiento, correo, cod_escuela&lt;br&gt;cod_escuela → nombre_escuela &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(transitiva)&lt;/font&gt;&lt;/i&gt;&lt;br&gt;fecha_nacimiento → edad &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(derivado)&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej5a-a2-0"><mxGeometry x="0" y="32" width="668" height="74" as="geometry"/></mxCell><mxCell id="ej5a-a2-1" value="MATRICULA" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="752" y="292" width="668" height="106" as="geometry"/></mxCell><mxCell id="ej5a-a2-1-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;(cod_alumno, cod_curso) → docente, semestre, nota1, nota2, nota3&lt;br&gt;docente → cod_curso &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(FNBC)&lt;/font&gt;&lt;/i&gt;&lt;br&gt;nota1, nota2, nota3 → promedio &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(derivado)&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej5a-a2-1"><mxGeometry x="0" y="32" width="668" height="74" as="geometry"/></mxCell><mxCell id="ej5a-a2-2" value="CURSO" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="422" width="668" height="70" as="geometry"/></mxCell><mxCell id="ej5a-a2-2-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;cod_curso → nombre_curso, creditos&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej5a-a2-2"><mxGeometry x="0" y="32" width="668" height="38" as="geometry"/></mxCell><mxCell id="ej5a-a2c" value="&lt;b&gt;No hay parciales:&lt;/b&gt; en MATRICULA nada depende solo de cod_alumno o solo de cod_curso (un curso puede tener varios docentes). ALUMNO y CURSO tienen PK simple." style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=12;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="60" y="506" width="1360" height="26" as="geometry"/></mxCell><mxCell id="ej5a-p3" value="" style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#FAFAFA;strokeColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="40" y="578" width="1400" height="300" as="geometry"/></mxCell><mxCell id="ej5a-p3-cap" value="A3. Dependencias transitivas (3FN) y atributos derivados" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="58" y="588" width="1364" height="24" as="geometry"/></mxCell><mxCell id="ej5a-a3-0" value="ALUMNO" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="620" width="668" height="106" as="geometry"/></mxCell><mxCell id="ej5a-a3-0-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;cod_alumno → cod_escuela → nombre_escuela&lt;br&gt;→ nueva tabla &lt;b&gt;ESCUELA&lt;/b&gt;(cod_escuela, nombre_escuela)&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej5a-a3-0"><mxGeometry x="0" y="32" width="668" height="74" as="geometry"/></mxCell><mxCell id="ej5a-a3-1" value="MATRICULA" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="752" y="620" width="668" height="106" as="geometry"/></mxCell><mxCell id="ej5a-a3-1-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;(cod_alumno, cod_curso) → docente → cod_curso&lt;br&gt;→ nueva tabla &lt;b&gt;DOCENTE&lt;/b&gt;(docente, cod_curso)&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;cod_curso es parte de la PK, así que no es transitiva como tal (es el caso de FNBC)&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej5a-a3-1"><mxGeometry x="0" y="32" width="668" height="74" as="geometry"/></mxCell><mxCell id="ej5a-a3-2" value="Atributos derivados" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="750" width="668" height="106" as="geometry"/></mxCell><mxCell id="ej5a-a3-2-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;edad: se calcula con fecha_nacimiento&lt;br&gt;promedio: se calcula con las notas parciales&lt;br&gt;&lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;No se guardan, se calculan en la consulta.&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej5a-a3-2"><mxGeometry x="0" y="32" width="668" height="74" as="geometry"/></mxCell><mxCell id="ej5a-p4" value="" style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#FAFAFA;strokeColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="40" y="902" width="1400" height="280" as="geometry"/></mxCell><mxCell id="ej5a-p4-cap" value="A4. Dependencias funcionales del modelo corregido" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="58" y="912" width="1364" height="24" as="geometry"/></mxCell><mxCell id="ej5a-a4-0" value="ESCUELA" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="944" width="322" height="88" as="geometry"/></mxCell><mxCell id="ej5a-a4-0-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;cod_escuela → nombre_escuela&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej5a-a4-0"><mxGeometry x="0" y="32" width="322" height="56" as="geometry"/></mxCell><mxCell id="ej5a-a4-1" value="ALUMNO" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="406" y="944" width="322" height="88" as="geometry"/></mxCell><mxCell id="ej5a-a4-1-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;cod_alumno → cod_escuela, nombres, apellidos, fecha_nacimiento, correo&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej5a-a4-1"><mxGeometry x="0" y="32" width="322" height="56" as="geometry"/></mxCell><mxCell id="ej5a-a4-2" value="CURSO" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="752" y="944" width="322" height="88" as="geometry"/></mxCell><mxCell id="ej5a-a4-2-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;cod_curso → nombre_curso, creditos&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej5a-a4-2"><mxGeometry x="0" y="32" width="322" height="56" as="geometry"/></mxCell><mxCell id="ej5a-a4-3" value="DOCENTE" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="1098" y="944" width="322" height="88" as="geometry"/></mxCell><mxCell id="ej5a-a4-3-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;docente → cod_curso&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej5a-a4-3"><mxGeometry x="0" y="32" width="322" height="56" as="geometry"/></mxCell><mxCell id="ej5a-a4-4" value="MATRICULA" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="1056" width="322" height="70" as="geometry"/></mxCell><mxCell id="ej5a-a4-4-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;(cod_alumno, cod_curso) → docente, semestre&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej5a-a4-4"><mxGeometry x="0" y="32" width="322" height="38" as="geometry"/></mxCell><mxCell id="ej5a-a4-5" value="NOTA_PARCIAL" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="406" y="1056" width="322" height="70" as="geometry"/></mxCell><mxCell id="ej5a-a4-5-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;(cod_alumno, cod_curso, nro_parcial) → nota&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej5a-a4-5"><mxGeometry x="0" y="32" width="322" height="38" as="geometry"/></mxCell><mxCell id="ej5a-a4n" value="&lt;b&gt;Nota:&lt;/b&gt; al registrar una matrícula hay que validar que el docente dicte ese curso." style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="60" y="1138" width="1360" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>