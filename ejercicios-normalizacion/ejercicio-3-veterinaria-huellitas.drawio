x="1" parent="ej3m-veterinario"><mxGeometry y="90" width="250" height="24" as="geometry"/></mxCell><mxCell id="ej3m-e0" value="tiene" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#595959;strokeWidth=1.5;fontSize=10;fontColor=#595959;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.2738;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5227;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej3m-dueno" target="ej3m-telefono_dueno"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej3m-e1" value="posee" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#595959;strokeWidth=1.5;fontSize=10;fontColor=#595959;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.2738;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2738;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej3m-dueno" target="ej3m-mascota"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej3m-e2" value="clasifica" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#595959;strokeWidth=1.5;fontSize=10;fontColor=#595959;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.3833;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.2738;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej3m-raza" target="ej3m-mascota"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej3m-e3" value="recibe" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#595959;strokeWidth=1.5;fontSize=10;fontColor=#595959;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej3m-mascota" target="ej3m-atencion"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej3m-e4" value="realiza" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#595959;strokeWidth=1.5;fontSize=10;fontColor=#595959;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.3833;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.2738;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej3m-veterinario" target="ej3m-atencion"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej3m-e5" value="incluye" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#595959;strokeWidth=1.5;fontSize=10;fontColor=#595959;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.2738;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3833;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej3m-atencion" target="ej3m-detalle_atencion"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej3m-e6" value="se incluye en" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#595959;strokeWidth=1.5;fontSize=10;fontColor=#595959;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.3833;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3833;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej3m-servicio" target="ej3m-detalle_atencion"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell></root></mxGraphModel></diagram><diagram id="ej3-analisis" name="Análisis (A1-A4)"><mxGraphModel dx="1480" dy="1260" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1260" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ej3a-title" value="Ejercicio 3 - Veterinaria Huellitas: análisis" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="900" height="30" as="geometry"/></mxCell><mxCell id="ej3a-p1" value="" style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#FAFAFA;strokeColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1400" height="152" as="geometry"/></mxCell><mxCell id="ej3a-p1-cap" value="A1. Atributos que violan la 1FN" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="58" y="84" width="1364" height="24" as="geometry"/></mxCell><mxCell id="ej3a-a1-0" value="telefonos  (DUENO)" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="116" width="668" height="88" as="geometry"/></mxCell><mxCell id="ej3a-a1-0-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;&lt;b&gt;Multivaluado:&lt;/b&gt; varios números separados por coma (&amp;quot;976543210, 044365412&amp;quot;).&lt;br&gt;→ tabla &lt;b&gt;TELEFONO_DUENO&lt;/b&gt;(dni_dueno, telefono)&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej3a-a1-0"><mxGeometry x="0" y="32" width="668" height="56" as="geometry"/></mxCell><mxCell id="ej3a-a1-1" value="nombres_apellidos  (DUENO)" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="752" y="116" width="668" height="88" as="geometry"/></mxCell><mxCell id="ej3a-a1-1-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;&lt;b&gt;No atómico:&lt;/b&gt; nombres y apellidos en un solo texto.&lt;br&gt;→ separar en &lt;b&gt;nombres&lt;/b&gt; y &lt;b&gt;apellidos&lt;/b&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej3a-a1-1"><mxGeometry x="0" y="32" width="668" height="56" as="geometry"/></mxCell><mxCell id="ej3a-p2" value="" style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#FAFAFA;strokeColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="1400" height="358" as="geometry"/></mxCell><mxCell id="ej3a-p2-cap" value="A2. Dependencias funcionales y dependencias parciales (2FN)" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="58" y="260" width="1364" height="24" as="geometry"/></mxCell><mxCell id="ej3a-a2-0" value="DUENO" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="292" width="668" height="124" as="geometry"/></mxCell><mxCell id="ej3a-a2-0-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;dni_dueno → nombres_apellidos, telefonos, direccion, correo&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej3a-a2-0"><mxGeometry x="0" y="32" width="668" height="92" as="geometry"/></mxCell><mxCell id="ej3a-a2-1" value="MASCOTA" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="752" y="292" width="668" height="124" as="geometry"/></mxCell><mxCell id="ej3a-a2-1-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;cod_mascota → dni_dueno, nombre, raza, fecha_nacimiento&lt;br&gt;dni_dueno → nombre_dueno &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(transitiva)&lt;/font&gt;&lt;/i&gt;&lt;br&gt;raza → especie, peso_promedio_raza &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(transitiva)&lt;/font&gt;&lt;/i&gt;&lt;br&gt;fecha_nacimiento → edad &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(derivado)&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej3a-a2-1"><mxGeometry x="0" y="32" width="668" height="92" as="geometry"/></mxCell><mxCell id="ej3a-a2-2" value="ATENCION" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="668" height="106" as="geometry"/></mxCell><mxCell id="ej3a-a2-2-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;cod_atencion → cod_mascota, fecha_atencion, cod_veterinario, motivo&lt;br&gt;cod_veterinario → nombre_veterinario, especialidad &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(transitiva)&lt;/font&gt;&lt;/i&gt;&lt;br&gt;suma de subtotales → total_atencion &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(derivado)&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej3a-a2-2"><mxGeometry x="0" y="32" width="668" height="74" as="geometry"/></mxCell><mxCell id="ej3a-a2-3" value="DETALLE_ATENCION" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="752" y="440" width="668" height="106" as="geometry"/></mxCell><mxCell id="ej3a-a2-3-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;(cod_atencion, cod_servicio) → cantidad&lt;br&gt;cod_servicio → nombre_servicio, precio_servicio &lt;font color=&quot;#C0392B&quot;&gt;&lt;b&gt;(parcial)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;precio_servicio × cantidad → subtotal &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(derivado)&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej3a-a2-3"><mxGeometry x="0" y="32" width="668" height="74" as="geometry"/></mxCell><mxCell id="ej3a-a2c" value="&lt;b&gt;Parcial:&lt;/b&gt; en DETALLE_ATENCION, nombre_servicio y precio_servicio dependen solo de cod_servicio, así que se crea la tabla SERVICIO. Las otras tablas tienen PK simple." style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=12;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="1360" height="26" as="geometry"/></mxCell><mxCell id="ej3a-p3" value="" style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#FAFAFA;strokeColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="40" y="632" width="1400" height="300" as="geometry"/></mxCell><mxCell id="ej3a-p3-cap" value="A3. Dependencias transitivas (3FN) y atributos derivados" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="58" y="642" width="1364" height="24" as="geometry"/></mxCell><mxCell id="ej3a-a3-0" value="MASCOTA" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="674" width="668" height="88" as="geometry"/></mxCell><mxCell id="ej3a-a3-0-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;cod_mascota → dni_dueno → nombre_dueno&lt;br&gt;→ se quita nombre_dueno (ya está en DUENO)&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej3a-a3-0"><mxGeometry x="0" y="32" width="668" height="56" as="geometry"/></mxCell><mxCell id="ej3a-a3-1" value="MASCOTA" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="752" y="674" width="668" height="88" as="geometry"/></mxCell><mxCell id="ej3a-a3-1-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;cod_mascota → raza → especie, peso_promedio_raza&lt;br&gt;→ nueva tabla &lt;b&gt;RAZA&lt;/b&gt;(raza, especie, peso_promedio_raza)&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej3a-a3-1"><mxGeometry x="0" y="32" width="668" height="56" as="geometry"/></mxCell><mxCell id="ej3a-a3-2" value="ATENCION" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlane