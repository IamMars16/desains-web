den;html=1;whiteSpace=wrap;" vertex="1" parent="ej3m-veterinario-r0"><mxGeometry width="62" height="26" as="geometry"><mxRectangle width="62" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej3m-veterinario-r0-a" value="cod_veterinario" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=1;fontSize=12;fontColor=#1A1A1A;align=left;spacingLeft=6;overflow=hidden;html=1;whiteSpace=wrap;" vertex="1" parent="ej3m-veterinario-r0"><mxGeometry x="62" width="208" height="26" as="geometry"><mxRectangle width="208" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej3m-veterinario-r1" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;strokeColor=#1F3A5F;html=1;" vertex="1" parent="ej3m-veterinario"><mxGeometry y="56" width="270" height="26" as="geometry"/></mxCell><mxCell id="ej3m-veterinario-r1-k" value="" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=1;fontSize=11;fontColor=#2E75B6;align=left;spacingLeft=8;overflow=hidden;html=1;whiteSpace=wrap;" vertex="1" parent="ej3m-veterinario-r1"><mxGeometry width="62" height="26" as="geometry"><mxRectangle width="62" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej3m-veterinario-r1-a" value="nombre_veterinario" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=0;fontSize=12;fontColor=#1A1A1A;align=left;spacingLeft=6;overflow=hidden;html=1;whiteSpace=wrap;" vertex="1" parent="ej3m-veterinario-r1"><mxGeometry x="62" width="208" height="26" as="geometry"><mxRectangle width="208" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej3m-veterinario-r2" value="" style="shape=tableRow;horizontal=0;startSize=0;swimlaneHead=0;swimlaneBody=0;fillColor=none;collapsible=0;dropTarget=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;top=0;left=0;right=0;bottom=0;strokeColor=#1F3A5F;html=1;" vertex="1" parent="ej3m-veterinario"><mxGeometry y="82" width="270" height="26" as="geometry"/></mxCell><mxCell id="ej3m-veterinario-r2-k" value="" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=1;fontSize=11;fontColor=#2E75B6;align=left;spacingLeft=8;overflow=hidden;html=1;whiteSpace=wrap;" vertex="1" parent="ej3m-veterinario-r2"><mxGeometry width="62" height="26" as="geometry"><mxRectangle width="62" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej3m-veterinario-r2-a" value="especialidad" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=0;fontSize=12;fontColor=#1A1A1A;align=left;spacingLeft=6;overflow=hidden;html=1;whiteSpace=wrap;" vertex="1" parent="ej3m-veterinario-r2"><mxGeometry x="62" width="208" height="26" as="geometry"><mxRectangle width="208" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej3m-e0" value="TIENE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.2687;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.5244;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej3m-dueno" target="ej3m-telefono_dueno"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej3m-e1" value="POSEE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.2687;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2687;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej3m-dueno" target="ej3m-mascota"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej3m-e2" value="CLASIFICA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.3981;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.2687;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej3m-raza" target="ej3m-mascota"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej3m-e3" value="RECIBE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej3m-mascota" target="ej3m-atencion"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej3m-e4" value="REALIZA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.3981;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.2687;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej3m-veterinario" target="ej3m-atencion"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej3m-e5" value="INCLUYE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.2687;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3981;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej3m-atencion" target="ej3m-detalle_atencion"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej3m-e6" value="SE INCLUYE EN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.3981;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.3981;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej3m-servicio" target="ej3m-detalle_atencion"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej3m-legend" value="&lt;b style=&quot;color:#C55A11&quot;&gt;PK&lt;/b&gt; clave primaria &amp;nbsp;·&amp;nbsp; &lt;b style=&quot;color:#2E75B6&quot;&gt;FK&lt;/b&gt; clave foránea &amp;nbsp;·&amp;nbsp; &lt;b&gt;||&lt;/b&gt; = uno &amp;nbsp;·&amp;nbsp; pata de gallo = muchos" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="580" width="1530" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ej3-analisis" name="A1–A4 · Análisis"><mxGraphModel dx="1260" dy="870" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="870" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ej3a-title" value="Ejercicio 3 · Veterinaria Huellitas — Análisis (A1–A4)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej3a-A1-h" value="A1 · Atributos que violan la 1FN" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej3a-A1-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;DUENO.telefonos&lt;/b&gt; → multivaluado. Guarda varios números separados por coma (&amp;quot;976543210, 044365412&amp;quot;). Solución: tabla &lt;b&gt;TELEFONO_DUENO(dni_dueno, telefono)&lt;/b&gt;, una fila por número.&lt;br&gt;•&amp;nbsp; &lt;b&gt;DUENO.nombres_apellidos&lt;/b&gt; → no atómico. Guarda nombres y apellidos en un solo texto. Solución: separar en &lt;b&gt;nombres&lt;/b&gt; y &lt;b&gt;apellidos&lt;/b&gt;.&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1180" height="80" as="geometry"/></mxCell><mxCell id="ej3a-A2-h" value="A2 · Dependencias funcionales y dependencias parciales (2FN)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="214" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej3a-A2-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;DUENO:&lt;/b&gt; dni_dueno → nombres_apellidos, telefonos, direccion, correo&lt;br&gt;•&amp;nbsp; &lt;b&gt;MASCOTA:&lt;/b&gt; cod_mascota → dni_dueno, nombre_dueno, nombre, especie, raza, peso_promedio_raza, fecha_nacimiento, edad  ·  dni_dueno → nombre_dueno  ·  raza → especie, peso_promedio_raza  ·  fecha_nacimiento → edad&lt;br&gt;•&amp;nbsp; &lt;b&gt;ATENCION:&lt;/b&gt; cod_atencion → cod_mascota, fecha_atencion, cod_veterinario, nombre_veterinario, especialidad, motivo, total_atencion  ·  cod_veterinario → nombre_veterinario, especialidad&lt;br&gt;•&amp;nbsp; &lt;b&gt;DETALLE_ATENCION:&lt;/b&gt; (cod_atencion, cod_servicio) → cantidad, subtotal  ·  cod_servicio → nombre_servicio, precio_servicio  ·  (precio_servicio, cantidad) → subtotal&lt;br&gt;•&amp;nbsp; &lt;b&gt;Dependencia parcial:&lt;/b&gt; en DETALLE_ATENCION, nombre_servicio y precio_servicio dependen solo de cod_servicio (una parte de la PK). Se crea &lt;b&gt;SERVICIO(cod_servicio, nombre_servicio, precio_servicio)&lt;/b&gt;. DUENO, MASCOTA y ATENCION tienen PK simple, por eso no tienen dependencias parciales.&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="244" width="1180" height="170" as="geometry"/></mxCell><mxCell id="ej3a-A3-h" value="A3 · Dependencias transitivas (3FN) y atributos derivados" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="438" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej3a-A3-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;MASCOTA:&lt;/b&gt; cod_mascota → dni_dueno → nombre_dueno. nombre_dueno ya está en DUENO: se elimina de MASCOTA.&lt;br&gt;•&amp;nbsp; &lt;b&gt;MASCOTA:&lt;/b&gt; cod_mascota → raza → especie, peso_promedio_raza (cada raza pertenece a una única especie y tiene un único peso promedio). Se crea &lt;b&gt;RAZA(raza, especie, peso_promedio_raza)&lt;/b&gt; y MASCOTA guarda raza como FK.&lt;br&gt;•&amp;nbsp; &lt;b&gt;ATENCION:&lt;/b&gt; cod_atencion → cod_veterinario → nombre_veterinario, especialidad. Se crea &lt;b&gt;VETERINARIO(cod_veterinario, nombre_veterinario, especialidad)&lt;/b&gt;.&lt;br&gt;•&amp;nbsp; &lt;b&gt;Atributos derivados (se eliminan y se calculan en la consulta):&lt;/b&gt; edad (se calcula con fecha_nacimiento), subtotal (= precio_servicio × cantidad) y total_atencion (= suma de los subtotales de la atención).&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="468" width="1180" height="134" as="geometry"/></mxCell><mxCell id="ej3a-A4-h" value="A4 · Dependencias funcionales del modelo corregido" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="626" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej3a-A4-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;DUENO:&lt;/b&gt; dni_dueno → nombres, apellidos, direccion, correo&lt;br&gt;•&amp;nbsp; &lt;b&gt;TELEFONO_DUENO:&lt;/b&gt; (dni_dueno, telefono) → clave completa (no tiene atributos no clave)&lt;br&gt;•&amp;nbsp; &lt;b&gt;RAZA:&lt;/b&gt; raza → especie, peso_promedio_raza&lt;br&gt;•&amp;nbsp; &lt;b&gt;MASCOTA:&lt;/b&gt; cod_mascota → dni_dueno, raza, nombre, fecha_nacimiento&lt;br&gt;•&amp;nbsp; &lt;b&gt;VETERINARIO:&lt;/b&gt; cod_veterinario → nombre_veterinario, especialidad&lt;br&gt;•&amp;nbsp; &lt;b&gt;ATENCION:&lt;/b&gt; cod_atencion → cod_mascota, cod_veterinario, fecha_atencion, motivo&lt;br&gt;•&amp;nbsp; &lt;b&gt;SERVICIO:&lt;/b&gt; cod_servicio → nombre_servicio, precio_servicio&lt;br&gt;•&amp;nbsp; &lt;b&gt;DETALLE_ATENCION:&lt;/b&gt; (cod_atencion, cod_servicio) → cantidad&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="656" width="1180" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>