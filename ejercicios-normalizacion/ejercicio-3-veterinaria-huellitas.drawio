ion&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;cod_mascota, fecha_atencion, cod_veterinario, motivo" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="194.0" y="602.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t2-p1" value="TRANSITIVA · 3FN" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F4ECF7;strokeColor=#6C3483;fontColor=#6C3483;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54.0" y="637.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t2-f1" value="&lt;b&gt;cod_veterinario&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;nombre_veterinario, especialidad" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="194.0" y="632.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t2-p2" value="DERIVADO" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#E9F7EF;strokeColor=#1E8449;fontColor=#1E8449;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54.0" y="667.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t2-f2" value="&lt;b&gt;suma de subtotales&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;total_atencion" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="194.0" y="662.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t3" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#C9D3DF;" vertex="1" parent="1"><mxGeometry x="760.0" y="564.0" width="700.0" height="132.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t3-h" value="&lt;b&gt;DETALLE_ATENCION&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#5B6773;font-size:11px&quot;&gt;(tabla original) · PK compuesta: (cod_atencion, cod_servicio)&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#EAF0F7;strokeColor=#C9D3DF;fontColor=#1F3A5F;fontSize=13;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760.0" y="564.0" width="700.0" height="34.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t3-p0" value="DEPENDE DE LA PK" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F1F4F7;strokeColor=#4A5A6A;fontColor=#4A5A6A;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="774.0" y="607.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t3-f0" value="&lt;b&gt;(cod_atencion, cod_servicio)&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;cantidad" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="914.0" y="602.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t3-p1" value="PARCIAL · 2FN" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#FDF0E6;strokeColor=#C55A11;fontColor=#C55A11;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="774.0" y="637.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t3-f1" value="&lt;b&gt;cod_servicio&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;nombre_servicio, precio_servicio" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="914.0" y="632.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t3-p2" value="DERIVADO" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#E9F7EF;strokeColor=#1E8449;fontColor=#1E8449;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="774.0" y="667.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t3-f2" value="&lt;b&gt;precio_servicio × cantidad&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;subtotal" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="914.0" y="662.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-c" value="&lt;b&gt;Dependencia parcial:&lt;/b&gt; en DETALLE_ATENCION, nombre_servicio y precio_servicio dependen solo de cod_servicio (cada servicio tiene un código único, un nombre y un precio de lista). &lt;b&gt;Se crea SERVICIO(cod_servicio, nombre_servicio, precio_servicio).&lt;/b&gt; DUENO, MASCOTA y ATENCION tienen PK simple, por eso no pueden tener dependencias parciales." style="html=1;whiteSpace=wrap;rounded=1;arcSize=8;fillColor=#FDF0E6;strokeColor=#C55A11;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=16;spacingRight=16;" vertex="1" parent="1"><mxGeometry x="40.0" y="712.0" width="1420.0" height="54.0" as="geometry"/></mxCell><mxCell id="ej3a-A3" value="&lt;b&gt;A3&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;Dependencias transitivas (3FN) y atributos derivados&lt;/b&gt;&lt;span style=&quot;color:#C9D6E5;font-weight:normal&quot;&gt;&amp;nbsp;&amp;nbsp;—&amp;nbsp;&amp;nbsp;un atributo no clave depende de otro atributo no clave · atributos que se calculan&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=14;fillColor=#1F3A5F;strokeColor=none;fontColor=#FFFFFF;fontSize=14;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40.0" y="800.0" width="1420.0" height="36.0" as="geometry"/></mxCell><mxCell id="ej3a-A3-i0" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C9D3DF;" vertex="1" parent="1"><mxGeometry x="40.0" y="848.0" width="1420.0" height="83.0" as="geometry"/></mxCell><mxCell id="ej3a-A3-i0-t" value="MASCOTA" style="html=1;wh