Color=#FFFFFF;fontSize=14;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40.0" y="338.0" width="1420.0" height="36.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t0" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#C9D3DF;" vertex="1" parent="1"><mxGeometry x="40.0" y="386.0" width="700.0" height="162.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t0-h" value="&lt;b&gt;DUENO&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#5B6773;font-size:11px&quot;&gt;(tabla original) · PK simple: dni_dueno&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#EAF0F7;strokeColor=#C9D3DF;fontColor=#1F3A5F;fontSize=13;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40.0" y="386.0" width="700.0" height="34.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t0-p0" value="DEPENDE DE LA PK" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F1F4F7;strokeColor=#4A5A6A;fontColor=#4A5A6A;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54.0" y="429.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t0-f0" value="&lt;b&gt;dni_dueno&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;nombres_apellidos, telefonos, direccion, correo" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="194.0" y="424.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t1" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=3;fillColor=#FFFFFF;strokeColor=#C9D3DF;" vertex="1" parent="1"><mxGeometry x="760.0" y="386.0" width="700.0" height="162.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t1-h" value="&lt;b&gt;MASCOTA&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;span style=&quot;color:#5B6773;font-size:11px&quot;&gt;(tabla original) · PK simple: cod_mascota&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=12;fillColor=#EAF0F7;strokeColor=#C9D3DF;fontColor=#1F3A5F;fontSize=13;align=left;spacingLeft=14;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="760.0" y="386.0" width="700.0" height="34.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t1-p0" value="DEPENDE DE LA PK" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F1F4F7;strokeColor=#4A5A6A;fontColor=#4A5A6A;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="774.0" y="429.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t1-f0" value="&lt;b&gt;cod_mascota&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;dni_dueno, nombre, raza, fecha_nacimiento" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="914.0" y="424.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t1-p1" value="TRANSITIVA · 3FN" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F4ECF7;strokeColor=#6C3483;fontColor=#6C3483;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="774.0" y="459.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t1-f1" value="&lt;b&gt;dni_dueno&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;nombre_dueno" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=12;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="914.0" y="454.0" width="532.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t1-p2" value="TRANSITIVA · 3FN" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#F4ECF7;strokeColor=#6C3483;fontColor=#6C3483;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="774.0" y="489.0" width="128.0" height="20.0" as="geometry"/></mxCell><mxCell id="ej3a-A2-t1-f2" value="&lt;b&gt;raza&lt;/b&gt;&amp;