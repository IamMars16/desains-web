la atención." style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=11;fontColor=#5B6773;" vertex="1" parent="1"><mxGeometry x="230.0" y="1377.0" width="1210.0" height="19.0" as="geometry"/></mxCell><mxCell id="ej3a-A4" value="&lt;b&gt;A4&lt;/b&gt;&amp;nbsp;&amp;nbsp;·&amp;nbsp;&amp;nbsp;&lt;b&gt;Dependencias funcionales del modelo corregido&lt;/b&gt;&lt;span style=&quot;color:#C9D6E5;font-weight:normal&quot;&gt;&amp;nbsp;&amp;nbsp;—&amp;nbsp;&amp;nbsp;en cada tabla final la PK determina todo lo demás&lt;/span&gt;" style="html=1;whiteSpace=wrap;rounded=1;arcSize=14;fillColor=#1F3A5F;strokeColor=none;fontColor=#FFFFFF;fontSize=14;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1"><mxGeometry x="40.0" y="1440.0" width="1420.0" height="36.0" as="geometry"/></mxCell><mxCell id="ej3a-A4-dueno-h" value="DUENO" style="html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="40.0" y="1488.0" width="340.0" height="28.0" as="geometry"/></mxCell><mxCell id="ej3a-A4-dueno-b" value="&lt;b&gt;dni_dueno&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;nombres, apellidos, direccion, correo" style="html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=middle;spacingLeft=12;spacingRight=12;" vertex="1" parent="1"><mxGeometry x="40.0" y="1516.0" width="340.0" height="54.0" as="geometry"/></mxCell><mxCell id="ej3a-A4-telefono_dueno-h" value="TELEFONO_DUENO" style="html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=12;align=left;spacingLeft=12;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="400.0" y="1488.0" width="340.0" height="28.0" as="geometry"/></mxCell><mxCell id="ej3a-A4-telefono_dueno-b" value="&lt;b&gt;(dni_dueno, telefono)&lt;/b&gt;&amp;nbsp;&amp;nbsp;→&amp;nbsp;&amp;nbsp;clave completa