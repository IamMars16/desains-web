digo y una descripción. Una marcación puede no tener justificación: en ASISTENCIA, cod_justificacion es FK opcional." style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=11;fontColor=#5B6773;" vertex="1" parent="1"><mxGeometry x="230.0" y="1042.0" width="1210.0" height="19.0" as="geometry"/></mxCell><mxCell id="ej4a-A3-i3" value="" style="html=1;whiteSpace=wrap;rounded=1;arcSize=4;fillColor=#FFFFFF;strokeColor=#C9D3DF;" vertex="1" parent="1"><mxGeometry x="40.0" y="1083.0" width="1420.0" height="83.0" as="geometry"/></mxCell><mxCell id="ej4a-A3-i3-t" value="ASISTENCIA" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=13;fontStyle=1;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="54.0" y="1095.0" width="170.0" height="22.0" as="geometry"/></mxCell><mxCell id="ej4a-A3-i3-k" value="DERIVADO" style="html=1;whiteSpace=wrap;rounded=1;arcSize=50;fillColor=#E9F7EF;strokeColor=#1E8449;fontColor=#1E8449;fontSize=9;fontStyle=1;align=center;verticalAlign=middle;spacing=0;" vertex="1" parent="1"><mxGeometry x="54.0" y="1121.0" width="71.7" height="20.0" as="geometry"/></mxCell><mxCell id="ej4a-A3-i3-n0" value="horas marcadas + horario asignado" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#FFFFFF;strokeColor=#C9D3DF;fontStyle=0;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="230.0" y="1097.0" width="238.1" height="30.0" as="geometry"/></mxCell><mxCell id="ej4a-A3-i3-n1" value="horas_trabajadas, minutos_tardanza" style="html=1;whiteSpace=wrap;rounded=1;arcSize=40;fillColor=#E9F7EF;strokeColor=#1E8449;fontStyle=1;fontColor=#1A1A1A;fontSize=12;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="512.1" y="1097.0" width="251.0" height="30.0" as="geometry"/></mxCell><mxCell id="ej4a-A3-i3-n1-a" value="" style="endArrow=block;endFill=1;endSize=7;html=1;strokeColor=#1F3A5F;strokeWidth=1.5;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=