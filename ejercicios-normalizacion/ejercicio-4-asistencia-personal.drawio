><mxGeometry y="56" width="270" height="26" as="geometry"/></mxCell><mxCell id="ej4m-horario_dia-r1-k" value="PK" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=1;fontSize=11;fontColor=#C55A11;align=left;spacingLeft=8;overflow=hidden;html=1;whiteSpace=wrap;" vertex="1" parent="ej4m-horario_dia-r1"><mxGeometry width="62" height="26" as="geometry"><mxRectangle width="62" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej4m-horario_dia-r1-a" value="dia_laborable" style="shape=partialRectangle;connectable=0;fillColor=none;top=0;left=0;bottom=0;right=0;fontStyle=1;fontSize=12;fontColor=#1A1A1A;align=left;spacingLeft=6;overflow=hidden;html=1;whiteSpace=wrap;" vertex="1" parent="ej4m-horario_dia-r1"><mxGeometry x="62" width="208" height="26" as="geometry"><mxRectangle width="208" height="26" as="alternateBounds"/></mxGeometry></mxCell><mxCell id="ej4m-e0" value="PERTENECE A" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.5244;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2687;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej4m-area" target="ej4m-empleado"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej4m-e1" value="TIENE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.9187;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej4m-cargo" target="ej4m-empleado"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="175.0" y="267.0"/></Array></mxGeometry></mxCell><mxCell id="ej4m-e2" value="MARCA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.2687;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2687;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej4m-empleado" target="ej4m-asistencia"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej4m-e3" value="JUSTIFICA" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.5244;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.2687;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej4m-justificacion" target="ej4m-asistencia"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej4m-e4" value="TIENE ASIGNADO" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej4m-empleado" target="ej4m-asignacion_horario"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej4m-e5" value="SE ASIGNA EN" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.3209;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3209;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej4m-horario" target="ej4m-asignacion_horario"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej4m-e6" value="DEFINE" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=12;endSize=12;strokeColor=#1F3A5F;strokeWidth=1.5;fontSize=10;fontStyle=1;fontColor=#1F3A5F;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.3209;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5244;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej4m-horario" target="ej4m-horario_dia"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej4m-legend" value="&lt;b style=&quot;color:#C55A11&quot;&gt;PK&lt;/b&gt; clave primaria &amp;nbsp;·&amp;nbsp; &lt;b style=&quot;color:#2E75B6&quot;&gt;FK&lt;/b&gt; clave foránea &amp;nbsp;·&amp;nbsp; &lt;b&gt;||&lt;/b&gt; = uno &amp;nbsp;·&amp;nbsp; pata de gallo = muchos &amp;nbsp;·&amp;nbsp; &lt;b&gt;o|&lt;/b&gt; = cero o uno (justificación opcional)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=11;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="40" y="554" width="1530" height="24" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ej4-analisis" name="A1–A4 · Análisis"><mxGraphModel dx="1260" dy="834" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1260" pageHeight="834" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ej4a-title" value="Ejercicio 4 · Control de asistencia del personal — Análisis (A1–A4)" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#1F3A5F;" vertex="1" parent="1"><mxGeometry x="40" y="30" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej4a-A1-h" value="A1 · Atributos que violan la 1FN" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej4a-A1-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;HORARIO.dias_laborables&lt;/b&gt; → multivaluado. Guarda varios días en un solo texto (&amp;quot;Lun,Mar,Mie,Jue,Vie&amp;quot;). Solución: tabla &lt;b&gt;HORARIO_DIA(cod_horario, dia_laborable)&lt;/b&gt;, una fila por día.&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1180" height="62" as="geometry"/></mxCell><mxCell id="ej4a-A2-h" value="A2 · Dependencias funcionales y dependencias parciales (2FN)" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="196" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej4a-A2-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;EMPLEADO:&lt;/b&gt; cod_empleado → nombres, apellidos, cod_area, nombre_area, cod_cargo, nombre_cargo, sueldo_base  ·  cod_area → nombre_area  ·  cod_cargo → nombre_cargo, sueldo_base&lt;br&gt;•&amp;nbsp; &lt;b&gt;ASISTENCIA:&lt;/b&gt; (cod_empleado, fecha) → hora_ingreso, hora_salida, horas_trabajadas, minutos_tardanza, cod_justificacion, descripcion_justificacion  ·  cod_empleado → nombre_empleado  ·  cod_justificacion → descripcion_justificacion&lt;br&gt;•&amp;nbsp; &lt;b&gt;ASIGNACION_HORARIO:&lt;/b&gt; (cod_empleado, cod_horario, fecha_inicio) → fecha_fin  ·  cod_empleado → nombre_empleado  ·  cod_horario → hora_entrada&lt;br&gt;•&amp;nbsp; &lt;b&gt;HORARIO:&lt;/b&gt; cod_horario → nombre_turno, hora_entrada, hora_salida, dias_laborables&lt;br&gt;•&amp;nbsp; &lt;b&gt;Dependencias parciales:&lt;/b&gt; en ASISTENCIA, cod_empleado → nombre_empleado; en ASIGNACION_HORARIO, cod_empleado → nombre_empleado y cod_horario → hora_entrada. Esos atributos dependen solo de una parte de la PK y ya están en EMPLEADO y HORARIO: se eliminan.&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="226" width="1180" height="170" as="geometry"/></mxCell><mxCell id="ej4a-A3-h" value="A3 · Dependencias transitivas (3FN) y atributos derivados" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="420" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej4a-A3-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;EMPLEADO:&lt;/b&gt; cod_empleado → cod_area → nombre_area. Se crea &lt;b&gt;AREA(cod_area, nombre_area)&lt;/b&gt;.&lt;br&gt;•&amp;nbsp; &lt;b&gt;EMPLEADO:&lt;/b&gt; cod_empleado → cod_cargo → nombre_cargo, sueldo_base (el sueldo base depende del cargo). Se crea &lt;b&gt;CARGO(cod_cargo, nombre_cargo, sueldo_base)&lt;/b&gt;.&lt;br&gt;•&amp;nbsp; &lt;b&gt;ASISTENCIA:&lt;/b&gt; (cod_empleado, fecha) → cod_justificacion → descripcion_justificacion. Se crea &lt;b&gt;JUSTIFICACION(cod_justificacion, descripcion_justificacion)&lt;/b&gt;; en ASISTENCIA, cod_justificacion es FK opcional porque una marcación puede no tener justificación.&lt;br&gt;•&amp;nbsp; &lt;b&gt;Atributos derivados:&lt;/b&gt; horas_trabajadas y minutos_tardanza se obtienen de las horas marcadas y del horario asignado: se eliminan y se calculan en la consulta.&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="450" width="1180" height="116" as="geometry"/></mxCell><mxCell id="ej4a-A4-h" value="A4 · Dependencias funcionales del modelo corregido" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#1F3A5F;strokeColor=#1F3A5F;fontColor=#FFFFFF;fontStyle=1;fontSize=13;align=left;spacingLeft=14;" vertex="1" parent="1"><mxGeometry x="40" y="590" width="1180" height="30" as="geometry"/></mxCell><mxCell id="ej4a-A4-b" value="&lt;div style=&quot;line-height:18px&quot;&gt;•&amp;nbsp; &lt;b&gt;AREA:&lt;/b&gt; cod_area → nombre_area&lt;br&gt;•&amp;nbsp; &lt;b&gt;CARGO:&lt;/b&gt; cod_cargo → nombre_cargo, sueldo_base&lt;br&gt;•&amp;nbsp; &lt;b&gt;EMPLEADO:&lt;/b&gt; cod_empleado → nombres, apellidos, cod_area, cod_cargo&lt;br&gt;•&amp;nbsp; &lt;b&gt;HORARIO:&lt;/b&gt; cod_horario → nombre_turno, hora_entrada, hora_salida&lt;br&gt;•&amp;nbsp; &lt;b&gt;HORARIO_DIA:&lt;/b&gt; (cod_horario, dia_laborable) → clave completa (no tiene atributos no clave)&lt;br&gt;•&amp;nbsp; &lt;b&gt;ASIGNACION_HORARIO:&lt;/b&gt; (cod_empleado, cod_horario, fecha_inicio) → fecha_fin&lt;br&gt;•&amp;nbsp; &lt;b&gt;JUSTIFICACION:&lt;/b&gt; cod_justificacion → descripcion_justificacion&lt;br&gt;•&amp;nbsp; &lt;b&gt;ASISTENCIA:&lt;/b&gt; (cod_empleado, fecha) → hora_ingreso, hora_salida, cod_justificacion&lt;/div&gt;" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#1F3A5F;fontColor=#1A1A1A;fontSize=12;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=10;spacingBottom=10;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="1180" height="170" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>