10;strokeColor=#595959;strokeWidth=1.5;fontSize=10;fontColor=#595959;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=0.0000;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.8929;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej4m-cargo" target="ej4m-empleado"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="165.0" y="240.0"/></Array></mxGeometry></mxCell><mxCell id="ej4m-e2" value="marca" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#595959;strokeWidth=1.5;fontSize=10;fontColor=#595959;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.2738;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.2738;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej4m-empleado" target="ej4m-asistencia"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej4m-e3" value="justifica" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERzeroToOne;endArrow=ERmany;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#595959;strokeWidth=1.5;fontSize=10;fontColor=#595959;labelBackgroundColor=#FFFFFF;dashed=1;exitX=0.0000;exitY=0.4792;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.2738;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej4m-justificacion" target="ej4m-asistencia"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej4m-e4" value="tiene asignado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#595959;strokeWidth=1.5;fontSize=10;fontColor=#595959;labelBackgroundColor=#FFFFFF;exitX=0.5000;exitY=1.0000;exitDx=0;exitDy=0;entryX=0.5000;entryY=0.0000;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej4m-empleado" target="ej4m-asignacion_horario"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej4m-e5" value="se asigna en" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#595959;strokeWidth=1.5;fontSize=10;fontColor=#595959;labelBackgroundColor=#FFFFFF;exitX=0.0000;exitY=0.3194;exitDx=0;exitDy=0;entryX=1.0000;entryY=0.3194;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej4m-horario" target="ej4m-asignacion_horario"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej4m-e6" value="define" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;startArrow=ERmandOne;endArrow=ERmany;startFill=0;endFill=0;startSize=10;endSize=10;strokeColor=#595959;strokeWidth=1.5;fontSize=10;fontColor=#595959;labelBackgroundColor=#FFFFFF;exitX=1.0000;exitY=0.3194;exitDx=0;exitDy=0;entryX=0.0000;entryY=0.5227;entryDx=0;entryDy=0;" edge="1" parent="1" source="ej4m-horario" target="ej4m-horario_dia"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="ej4m-nota" value="Línea punteada: la justificación es opcional (una marcación puede no tener justificación)." style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;fontColor=#777777;" vertex="1" parent="1"><mxGeometry x="40" y="522" width="900" height="22" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="ej4-analisis" name="Análisis (A1-A4)"><mxGraphModel dx="1480" dy="1242" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="1242" background="#FFFFFF" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="ej4a-title" value="Ejercicio 4 - Control de asistencia: análisis" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="40" y="24" width="900" height="30" as="geometry"/></mxCell><mxCell id="ej4a-p1" value="" style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#FAFAFA;strokeColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="40" y="74" width="1400" height="152" as="geometry"/></mxCell><mxCell id="ej4a-p1-cap" value="A1. Atributos que violan la 1FN" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="58" y="84" width="1364" height="24" as="geometry"/></mxCell><mxCell id="ej4a-a1-0" value="dias_laborables  (HORARIO)" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="116" width="668" height="88" as="geometry"/></mxCell><mxCell id="ej4a-a1-0-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;&lt;b&gt;Multivaluado:&lt;/b&gt; varios días en un solo texto (&amp;quot;Lun,Mar,Mie,Jue,Vie&amp;quot;).&lt;br&gt;→ tabla &lt;b&gt;HORARIO_DIA&lt;/b&gt;(cod_horario, dia_laborable)&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej4a-a1-0"><mxGeometry x="0" y="32" width="668" height="56" as="geometry"/></mxCell><mxCell id="ej4a-p2" value="" style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#FAFAFA;strokeColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="40" y="250" width="1400" height="358" as="geometry"/></mxCell><mxCell id="ej4a-p2-cap" value="A2. Dependencias funcionales y dependencias parciales (2FN)" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="58" y="260" width="1364" height="24" as="geometry"/></mxCell><mxCell id="ej4a-a2-0" value="EMPLEADO" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="292" width="668" height="124" as="geometry"/></mxCell><mxCell id="ej4a-a2-0-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;cod_empleado → nombres, apellidos, cod_area, cod_cargo&lt;br&gt;cod_area → nombre_area &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(transitiva)&lt;/font&gt;&lt;/i&gt;&lt;br&gt;cod_cargo → nombre_cargo, sueldo_base &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(transitiva)&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej4a-a2-0"><mxGeometry x="0" y="32" width="668" height="92" as="geometry"/></mxCell><mxCell id="ej4a-a2-1" value="ASISTENCIA" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="752" y="292" width="668" height="124" as="geometry"/></mxCell><mxCell id="ej4a-a2-1-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;(cod_empleado, fecha) → hora_ingreso, hora_salida, cod_justificacion&lt;br&gt;cod_empleado → nombre_empleado &lt;font color=&quot;#C0392B&quot;&gt;&lt;b&gt;(parcial)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;cod_justificacion → descripcion_justificacion &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(transitiva)&lt;/font&gt;&lt;/i&gt;&lt;br&gt;horas marcadas + horario → horas_trabajadas, minutos_tardanza &lt;i&gt;&lt;font color=&quot;#777777&quot;&gt;(derivado)&lt;/font&gt;&lt;/i&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej4a-a2-1"><mxGeometry x="0" y="32" width="668" height="92" as="geometry"/></mxCell><mxCell id="ej4a-a2-2" value="ASIGNACION_HORARIO" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="440" width="668" height="106" as="geometry"/></mxCell><mxCell id="ej4a-a2-2-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;(cod_empleado, cod_horario, fecha_inicio) → fecha_fin&lt;br&gt;cod_empleado → nombre_empleado &lt;font color=&quot;#C0392B&quot;&gt;&lt;b&gt;(parcial)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;cod_horario → hora_entrada &lt;font color=&quot;#C0392B&quot;&gt;&lt;b&gt;(parcial)&lt;/b&gt;&lt;/font&gt;&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej4a-a2-2"><mxGeometry x="0" y="32" width="668" height="74" as="geometry"/></mxCell><mxCell id="ej4a-a2-3" value="HORARIO" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="752" y="440" width="668" height="106" as="geometry"/></mxCell><mxCell id="ej4a-a2-3-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;cod_horario → nombre_turno, hora_entrada, hora_salida, dias_laborables&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej4a-a2-3"><mxGeometry x="0" y="32" width="668" height="74" as="geometry"/></mxCell><mxCell id="ej4a-a2c" value="&lt;b&gt;Parciales:&lt;/b&gt; nombre_empleado depende solo de cod_empleado (en ASISTENCIA y ASIGNACION_HORARIO) y hora_entrada solo de cod_horario (en ASIGNACION_HORARIO). Se quitan porque ya están en EMPLEADO y HORARIO." style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;fontSize=12;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="60" y="560" width="1360" height="26" as="geometry"/></mxCell><mxCell id="ej4a-p3" value="" style="html=1;whiteSpace=wrap;rounded=1;absoluteArcSize=1;arcSize=10;fillColor=#FAFAFA;strokeColor=#E0E0E0;" vertex="1" parent="1"><mxGeometry x="40" y="632" width="1400" height="282" as="geometry"/></mxCell><mxCell id="ej4a-p3-cap" value="A3. Dependencias transitivas (3FN) y atributos derivados" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=middle;fontSize=14;fontStyle=1;fontColor=#262626;" vertex="1" parent="1"><mxGeometry x="58" y="642" width="1364" height="24" as="geometry"/></mxCell><mxCell id="ej4a-a3-0" value="EMPLEADO" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A6;strokeWidth=1.5;fontColor=#262626;fontSize=13;" vertex="1" parent="1"><mxGeometry x="60" y="674" width="668" height="88" as="geometry"/></mxCell><mxCell id="ej4a-a3-0-t" value="&lt;div style=&quot;line-height:18px&quot;&gt;cod_empleado → cod_area → nombre_area&lt;br&gt;→ nueva tabla &lt;b&gt;AREA&lt;/b&gt;(cod_area, nombre_area)&lt;/div&gt;" style="html=1;whiteSpace=wrap;text;align=left;verticalAlign=top;spacingLeft=14;spacingRight=14;spacingTop=8;fontSize=12;fontColor=#262626;" vertex="1" parent="ej4a-a3-0"><mxGeometry x="0" y="32" width="668" height="56" as="geometry"/></mxCell><mxCell id="ej4a-a3-1" value="EMPLEADO" style="swimlane;fontStyle=1;startSize=32;horizontal=1;collapsible=0;rounded=1;absoluteArcSize=1;arcSize=12;html=1;whiteSpace=wrap;fillColor=#F2C14E;swimlaneFillColor=#FFFFFF;strokeColor=#A6A6A